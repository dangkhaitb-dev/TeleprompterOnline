{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vteleprompter.com/schemas/simple-page.schema.json",
  "title": "VTeleprompter simple content page",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "published", "title", "seo", "content"],
  "properties": {
    "$schema": { "type": "string" },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "published": { "type": "boolean" },
    "title": { "type": "string", "minLength": 1 },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "content": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/block" }
    }
  },
  "$defs": {
    "block": {
      "oneOf": [
        { "$ref": "#/$defs/paragraph" },
        { "$ref": "#/$defs/heading" },
        { "$ref": "#/$defs/list" },
        { "$ref": "#/$defs/image" }
      ]
    },
    "paragraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "html"],
      "properties": {
        "type": { "const": "paragraph" },
        "html": { "type": "string", "minLength": 1 }
      }
    },
    "heading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "heading" },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "list": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {
        "type": { "const": "list" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "src", "alt", "width", "height"],
      "properties": {
        "type": { "const": "image" },
        "src": { "type": "string", "minLength": 1 },
        "alt": { "type": "string", "minLength": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "caption": { "type": "string", "minLength": 1 }
      }
    }
  }
}
