{%- set pageData = i18nPages[pageKey][lang] or i18nPages[pageKey]['en'] -%}
<!DOCTYPE html>
<html lang="{{ lang or 'en' }}" data-theme="light">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ pageData.seo.description }}">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#f6f7f9">
    <title>{{ pageData.seo.title }}</title>
    {% include "partials/head-icons.njk" %}
</head>

<body>
    <main id="main" tabindex="-1">
        {{ content | safe }}
    </main>

    {% include "partials/feedback-widget.njk" %}
    <script type="module" src="/src/script/main.js"></script>
</body>

</html>
