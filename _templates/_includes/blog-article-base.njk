{%- set canonical = site.url + article.url -%}
<!DOCTYPE html>
<html lang="{{ lang or 'en' }}" data-theme="light">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ article.seo.description }}">
    <meta name="robots" content="index, follow">
    <meta name="color-scheme" content="light">
    <meta name="theme-color" content="#fbfcfd">
    <meta name="author" content="{{ article.author.name }}">
    <meta property="og:title" content="{{ article.seo.title }}">
    <meta property="og:description" content="{{ article.seo.description }}">
    <meta property="og:type" content="article">
    <meta property="og:url" content="{{ canonical }}">
    <meta property="og:site_name" content="{{ site.name }}">
    <meta property="og:image" content="{{ article.seo.image }}">
    <meta property="og:image:width" content="{{ article.hero.width }}">
    <meta property="og:image:height" content="{{ article.hero.height }}">
    <meta property="og:image:type" content="image/webp">
    <meta property="og:image:alt" content="{{ article.hero.alt }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ article.seo.title }}">
    <meta name="twitter:description" content="{{ article.seo.description }}">
    <meta name="twitter:image" content="{{ article.seo.image }}">
    <meta name="twitter:image:alt" content="{{ article.hero.alt }}">
    <meta property="article:published_time" content="{{ article.date }}">
    <meta property="article:modified_time" content="{{ article.modified }}">
    <link rel="canonical" href="{{ canonical }}">
    <title>{{ article.seo.title }}</title>
    {% include "partials/head-icons.njk" %}
</head>

<body class="home blog-article-page">
    {{ content | safe }}
    {% include "partials/support-widget.njk" %}
    {% include "partials/feedback-widget.njk" %}
    <script type="module" src="/src/script/blog-article-main.js"></script>
</body>

</html>
