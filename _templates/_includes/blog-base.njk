{%- set pageData = i18nPages[pageKey][lang] or i18nPages[pageKey]['en'] -%}
<!DOCTYPE html>
<html lang="{{ lang or 'en' }}" data-theme="light">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ pageData.seo.description }}">
    <meta name="robots" content="index, follow">
    <meta name="color-scheme" content="light">
    <meta name="theme-color" content="#fbfcfd">
    <meta property="og:title" content="{{ pageData.seo.title }}">
    <meta property="og:description" content="{{ pageData.seo.description }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ site.url }}/blog">
    <link rel="canonical" href="{{ site.url }}/blog">
    <title>{{ pageData.seo.title }}</title>
    {% include "partials/head-icons.njk" %}
</head>

<body class="home blog-page">
    {{ content | safe }}
    <script type="module" src="/src/script/blog-main.js"></script>
</body>

</html>
