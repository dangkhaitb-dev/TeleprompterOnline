{%- set pageData = i18nPages[pageKey][lang] or i18nPages[pageKey]['en'] -%}
{%- if category -%}
    {%- set pageTitle = category.name + ' ' + pageData.seo.categoryTitleSuffix -%}
    {%- set pageDescription = pageData.seo.categoryDescriptionPrefix + category.name + pageData.seo.categoryDescriptionSuffix -%}
    {%- set canonical = site.url + '/blog/' + category.slug + '/' -%}
{%- else -%}
    {%- set pageTitle = pageData.seo.title -%}
    {%- set pageDescription = pageData.seo.description -%}
    {%- set canonical = site.url + '/blog' -%}
{%- endif -%}
<!DOCTYPE html>
<html lang="{{ lang or 'en' }}" data-theme="light">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ pageDescription }}">
    <meta name="robots" content="index, follow">
    <meta name="color-scheme" content="light">
    <meta name="theme-color" content="#fbfcfd">
    <meta property="og:title" content="{{ pageTitle }}">
    <meta property="og:description" content="{{ pageDescription }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ canonical }}">
    <meta property="og:site_name" content="{{ site.name }}">
    <meta property="og:image" content="{{ site.url }}{{ site.socialImage.path }}">
    <meta property="og:image:width" content="{{ site.socialImage.width }}">
    <meta property="og:image:height" content="{{ site.socialImage.height }}">
    <meta property="og:image:type" content="{{ site.socialImage.type }}">
    <meta property="og:image:alt" content="{{ site.socialImage.alt }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ pageTitle }}">
    <meta name="twitter:description" content="{{ pageDescription }}">
    <meta name="twitter:image" content="{{ site.url }}{{ site.socialImage.path }}">
    <meta name="twitter:image:alt" content="{{ site.socialImage.alt }}">
    <link rel="canonical" href="{{ canonical }}">
    <title>{{ pageTitle }}</title>
    {% include "partials/head-icons.njk" %}
</head>

<body class="home blog-page">
    {{ content | safe }}
    <script type="module" src="/src/script/blog-main.js"></script>
</body>

</html>
