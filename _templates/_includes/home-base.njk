{%- set pageData = i18nPages[pageKey][lang] or i18nPages[pageKey]['en'] -%}
<!DOCTYPE html>
<html lang="{{ lang or 'en' }}" dir="{{ (lang or 'en') | langDir }}" data-theme="light">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ pageData.seo.description }}">
    <meta name="robots" content="{{ pageData.seo.robots or 'index, follow' }}">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#fbfcfd">
    <meta property="og:title" content="{{ pageData.seo.ogTitle or pageData.seo.title }}">
    <meta property="og:description" content="{{ pageData.seo.ogDescription or pageData.seo.description }}">
    <meta property="og:type" content="{{ pageData.seo.ogType or 'website' }}">
    <meta property="og:url" content="{{ site.url }}{{ pageData.seo.canonical or '/' }}">
    {%- if pageData.seo.ogImage %}
    <meta property="og:image" content="{{ site.url }}{{ pageData.seo.ogImage }}">
    <meta property="og:image:width" content="1536">
    <meta property="og:image:height" content="1024">
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:alt" content="{{ pageData.seo.ogImageAlt or pageData.seo.ogTitle or pageData.seo.title }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ pageData.seo.ogTitle or pageData.seo.title }}">
    <meta name="twitter:description" content="{{ pageData.seo.ogDescription or pageData.seo.description }}">
    <meta name="twitter:image" content="{{ site.url }}{{ pageData.seo.ogImage }}">
    <meta name="twitter:image:alt" content="{{ pageData.seo.ogImageAlt or pageData.seo.ogTitle or pageData.seo.title }}">
    {%- endif %}
    <link rel="canonical" href="{{ site.url }}{{ pageData.seo.canonical or '/' }}">
    {%- if pageKey == 'index' %}
    {#- hreflang cluster is the multilingual home only; single-language pages
        (e.g. about) reuse this layout but have no translations, so they must
        not emit these alternates. -#}
    {%- for l in site.languages %}
    <link rel="alternate" hreflang="{{ l.hreflang }}" href="{{ site.url }}{{ l.homePath }}">
    {%- endfor %}
    <link rel="alternate" hreflang="x-default" href="{{ site.url }}/">
    {%- endif %}
    <title>{{ pageData.seo.title }}</title>
    {% include "partials/head-icons.njk" %}
    {%- if pageKey == 'about' %}
    <link rel="stylesheet" href="/src/styles/about.css">
    {%- endif %}
    {%- include "partials/json-ld.njk" -%}
    {%- include "partials/pricing-json-ld.njk" %}
</head>

<body class="home">
    {{ content | safe }}
    {% include "partials/support-widget.njk" %}
    {% include "partials/feedback-widget.njk" %}
    <script type="module" src="/src/script/home-main.js"></script>
</body>

</html>
