{%- macro blogListing(articles, pageData) -%}
{%- if articles.length -%}
<div class="blog-listing">
    {%- for article in articles -%}
    {%- if loop.first %}
    <article class="blog-featured">
        <a class="blog-featured-media" href="/blog/{{ article.categorySlug }}/{{ article.slug }}/">
            <img
                src="{{ article.hero.src }}"
                width="{{ article.hero.width }}"
                height="{{ article.hero.height }}"
                alt="{{ article.hero.alt }}"
                loading="eager"
                fetchpriority="high"
                decoding="async">
        </a>
        <div class="blog-featured-content">
            <span class="blog-featured-label">{{ pageData.featuredArticle }}</span>
            <div class="blog-post-meta">
                <a class="blog-category-link" href="/blog/{{ article.categorySlug }}/">{{ article.category }}</a>
                <time datetime="{{ article.date }}">{{ article.dateDisplay }}</time>
            </div>
            <h2 class="blog-featured-title">
                <a href="/blog/{{ article.categorySlug }}/{{ article.slug }}/">{{ article.title }}</a>
            </h2>
            <p class="blog-featured-description">{{ article.seo.description }}</p>
            <a class="blog-read-link" href="/blog/{{ article.categorySlug }}/{{ article.slug }}/">
                {{ pageData.readArticle }} <span aria-hidden="true">↗</span>
            </a>
        </div>
    </article>
    {%- elif loop.index0 == 1 %}
    <div class="blog-grid">
        <article class="blog-card">
            <a class="blog-card-media" href="/blog/{{ article.categorySlug }}/{{ article.slug }}/">
                <img
                    src="{{ article.hero.src }}"
                    width="{{ article.hero.width }}"
                    height="{{ article.hero.height }}"
                    alt="{{ article.hero.alt }}"
                    loading="lazy"
                    decoding="async">
            </a>
            <div class="blog-card-content">
                <div class="blog-post-meta">
                    <a class="blog-category-link" href="/blog/{{ article.categorySlug }}/">{{ article.category }}</a>
                    <time datetime="{{ article.date }}">{{ article.dateDisplay }}</time>
                </div>
                <h2 class="blog-card-title">
                    <a href="/blog/{{ article.categorySlug }}/{{ article.slug }}/">{{ article.title }}</a>
                </h2>
                <p>{{ article.seo.description }}</p>
            </div>
        </article>
    {%- if loop.last %}</div>{% endif -%}
    {%- else %}
        <article class="blog-card">
            <a class="blog-card-media" href="/blog/{{ article.categorySlug }}/{{ article.slug }}/">
                <img
                    src="{{ article.hero.src }}"
                    width="{{ article.hero.width }}"
                    height="{{ article.hero.height }}"
                    alt="{{ article.hero.alt }}"
                    loading="lazy"
                    decoding="async">
            </a>
            <div class="blog-card-content">
                <div class="blog-post-meta">
                    <a class="blog-category-link" href="/blog/{{ article.categorySlug }}/">{{ article.category }}</a>
                    <time datetime="{{ article.date }}">{{ article.dateDisplay }}</time>
                </div>
                <h2 class="blog-card-title">
                    <a href="/blog/{{ article.categorySlug }}/{{ article.slug }}/">{{ article.title }}</a>
                </h2>
                <p>{{ article.seo.description }}</p>
            </div>
        </article>
    {%- if loop.last %}</div>{% endif -%}
    {%- endif %}
    {%- endfor %}
</div>
{%- else %}
<p class="blog-empty">{{ pageData.empty }}</p>
{%- endif %}
{%- endmacro %}
