{#- Build-time JSON-LD generator.

    Emits a schema.org @graph for the current page, assembled entirely from the
    page's content data (pageData.seo / pageData.schema) plus the shared `site`
    config, so the structured data can never drift from the visible copy:
      - HowTo steps  loop over pageData.howItWorks.steps
      - FAQ entries  loop over pageData.faq.items

    All text is escaped through the `jsonString` filter (eleventy.config.cjs).
    No-op on pages that don't declare `pageData.schema`. -#}
{%- if pageData.schema -%}
{%- set s = pageData.seo -%}
{%- set sc = pageData.schema -%}
{%- set base = site.url -%}
{%- set home = base + "/" -%}
{%- set canonicalUrl = base + (s.canonical or "/") -%}
{%- set langCode = lang or 'en' -%}
    <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "{{ home }}#organization",
      "name": "{{ site.name | jsonString | safe }}",
      "url": "{{ home }}",
      "description": "{{ sc.orgDescription | jsonString | safe }}",
      "logo": {
        "@type": "ImageObject",
        "@id": "{{ home }}#logo",
        "url": "{{ base }}{{ sc.logoUrl }}",
        "contentUrl": "{{ base }}{{ sc.logoUrl }}",
        "caption": "{{ sc.logoCaption | jsonString | safe }}"
      },
      "brand": { "@id": "{{ home }}#brand" }
    },
    {
      "@type": "Brand",
      "@id": "{{ home }}#brand",
      "name": "{{ site.name | jsonString | safe }}",
      "url": "{{ home }}",
      "logo": { "@id": "{{ home }}#logo" },
      "description": "{{ sc.brandDescription | jsonString | safe }}"
    },
    {
      "@type": "WebSite",
      "@id": "{{ home }}#website",
      "url": "{{ home }}",
      "name": "{{ site.name | jsonString | safe }}",
      "alternateName": [{% for n in sc.alternateNames %}"{{ n | jsonString | safe }}"{% if not loop.last %}, {% endif %}{% endfor %}],
      "description": "{{ sc.websiteDescription | jsonString | safe }}",
      "publisher": { "@id": "{{ home }}#organization" },
      "inLanguage": "{{ langCode }}"
    },
    {
      "@type": "WebPage",
      "@id": "{{ home }}#webpage",
      "url": "{{ canonicalUrl }}",
      "name": "{{ (sc.webpageName or s.title) | jsonString | safe }}",
      "description": "{{ s.description | jsonString | safe }}",
      "isPartOf": { "@id": "{{ home }}#website" },
      "publisher": { "@id": "{{ home }}#organization" },
      "about": { "@id": "{{ home }}#application" },
      "mainEntity": { "@id": "{{ home }}#application" },
      "primaryImageOfPage": {
        "@type": "ImageObject",
        "@id": "{{ home }}#primary-image",
        "url": "{{ base }}{{ sc.primaryImage }}",
        "contentUrl": "{{ base }}{{ sc.primaryImage }}",
        "caption": "{{ sc.primaryImageCaption | jsonString | safe }}"
      },
      "hasPart": [
        { "@id": "{{ home }}#how-to" },
        { "@id": "{{ home }}#faq" }
      ],
      "inLanguage": "{{ langCode }}"
    },
    {
      "@type": ["SoftwareApplication", "WebApplication"],
      "@id": "{{ home }}#application",
      "name": "{{ site.name | jsonString | safe }}",
      "alternateName": "{{ sc.appAlternateName | jsonString | safe }}",
      "url": "{{ home }}",
      "description": "{{ sc.appDescription | jsonString | safe }}",
      "applicationCategory": "{{ sc.applicationCategory | jsonString | safe }}",
      "applicationSubCategory": "{{ sc.applicationSubCategory | jsonString | safe }}",
      "operatingSystem": "{{ sc.operatingSystem | jsonString | safe }}",
      "browserRequirements": "{{ sc.browserRequirements | jsonString | safe }}",
      "availableOnDevice": [{% for d in sc.availableOnDevice %}"{{ d | jsonString | safe }}"{% if not loop.last %}, {% endif %}{% endfor %}],
      "isAccessibleForFree": true,
      "offers": {
        "@type": "Offer",
        "@id": "{{ home }}#free-offer",
        "url": "{{ home }}",
        "price": "0",
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "description": "{{ sc.offerDescription | jsonString | safe }}"
      },
      "featureList": [{% for f in sc.featureList %}"{{ f | jsonString | safe }}"{% if not loop.last %}, {% endif %}{% endfor %}],
      "image": { "@id": "{{ home }}#primary-image" },
      "brand": { "@id": "{{ home }}#brand" },
      "creator": { "@id": "{{ home }}#organization" },
      "provider": { "@id": "{{ home }}#organization" },
      "mainEntityOfPage": { "@id": "{{ home }}#webpage" },
      "inLanguage": "{{ langCode }}"
    },
    {
      "@type": "HowTo",
      "@id": "{{ home }}#how-to",
      "url": "{{ home }}#how-it-works",
      "name": "{{ sc.howToName | jsonString | safe }}",
      "description": "{{ sc.howToDescription | jsonString | safe }}",
      "about": { "@id": "{{ home }}#application" },
      "mainEntityOfPage": { "@id": "{{ home }}#webpage" },
      "step": [
        {%- for step in pageData.howItWorks.steps %}
        {
          "@type": "HowToStep",
          "@id": "{{ home }}#{{ step.anchor }}",
          "position": {{ loop.index }},
          "url": "{{ home }}#{{ step.anchor }}",
          "name": "{{ step.title | jsonString | safe }}",
          "text": "{{ step.description | jsonString | safe }}"
        }{% if not loop.last %},{% endif %}
        {%- endfor %}
      ],
      "inLanguage": "{{ langCode }}"
    },
    {
      "@type": "FAQPage",
      "@id": "{{ home }}#faq",
      "url": "{{ home }}#faq",
      "name": "{{ sc.faqName | jsonString | safe }}",
      "description": "{{ sc.faqDescription | jsonString | safe }}",
      "isPartOf": { "@id": "{{ home }}#webpage" },
      "about": { "@id": "{{ home }}#application" },
      "mainEntity": [
        {%- for item in pageData.faq.items %}
        {
          "@type": "Question",
          "@id": "{{ home }}#{{ item.anchor }}",
          "name": "{{ item.q | jsonString | safe }}",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "{{ item.a | jsonString | safe }}"
          }
        }{% if not loop.last %},{% endif %}
        {%- endfor %}
      ],
      "inLanguage": "{{ langCode }}"
    }
  ]
}
    </script>
{%- endif -%}
