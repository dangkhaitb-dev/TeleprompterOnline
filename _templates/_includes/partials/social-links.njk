{#- Official social channels, shared across every footer. Data lives in
    _data/site.cjs (`site.social`) so a new channel means one config entry
    plus one icon branch here:
    {% from "partials/social-links.njk" import socialLinks %}
    {{ socialLinks(site.social) }} -#}
{%- macro socialIcon(key) -%}
{%- if key == 'x' -%}
<svg class="footer-social-icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 2.5h3.4l-7.4 8.5 8.7 11.5h-6.8l-5.3-7-6.1 7H1.9l7.7-8.8L1.3 2.5h7l5 6.6 5.6-6.6Zm-1.2 17.9h1.9L6.4 4.4H4.4l13.3 16Z"/></svg>
{%- elif key == 'instagram' -%}
<svg class="footer-social-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="2.5" width="19" height="19" rx="5.4"/><circle cx="12" cy="12" r="4.1"/><circle cx="17.6" cy="6.4" r="1.1" fill="currentColor" stroke="none"/></svg>
{%- elif key == 'youtube' -%}
<svg class="footer-social-icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22.5 7.2a3.3 3.3 0 0 0-2.3-2.3C18.4 4.4 12 4.4 12 4.4s-6.4 0-8.2.5A3.3 3.3 0 0 0 1.5 7.2C1 9 1 12 1 12s0 3 .5 4.8a3.3 3.3 0 0 0 2.3 2.3c1.8.5 8.2.5 8.2.5s6.4 0 8.2-.5a3.3 3.3 0 0 0 2.3-2.3C23 15 23 12 23 12s0-3-.5-4.8ZM9.9 15.5v-7l6 3.5-6 3.5Z"/></svg>
{%- endif -%}
{%- endmacro -%}
{%- macro socialLinks(items) -%}
{%- if items and items.length %}
<ul class="footer-social">
    {%- for item in items %}
    <li>
        <a class="footer-social-link" href="{{ item.url }}" target="_blank" rel="noopener me" aria-label="{{ item.ariaLabel }}">{{ socialIcon(item.key) }}</a>
    </li>
    {%- endfor %}
</ul>
{%- endif %}
{%- endmacro -%}
