{%- set pageData = i18nPages[pageKey][lang] or i18nPages[pageKey]['en'] -%}
<!DOCTYPE html>
<html lang="{{ lang or 'en' }}" data-theme="light">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ pageData.seo.description }}">
    <meta name="robots" content="noindex, nofollow">
    <meta name="color-scheme" content="light">
    <meta name="theme-color" content="#f9fafd">
    <link rel="canonical" href="{{ site.url }}{{ pageData.seo.canonical or '/workspaces' }}">
    <title>{{ pageData.seo.title }}</title>
    {% include "partials/head-icons.njk" %}
    <script type="text/javascript" src="https://widget.trustpilot.com/bootstrap/v5/tp.widget.bootstrap.min.js" async></script>
    {#- Keep brand icons at their final size before module-loaded CSS arrives. -#}
    <style>
      .ws-appbar-logo .shared-brand-logo {
        display: inline-flex;
        width: 32px;
        height: 32px;
        flex: 0 0 32px;
      }

      .ws-appbar-logo .shared-brand-logo svg {
        display: block;
        width: 32px;
        height: 32px;
      }

      .ws-credits-icon,
      .ws-credits-icon svg {
        display: inline-flex;
        width: 18px;
        height: 18px;
      }
    </style>
</head>

<body class="ws-body">
    {{ content | safe }}
    {% include "partials/support-widget.njk" %}
    {% include "partials/feedback-widget.njk" %}
    <script type="module" src="/src/script/workspaces-main.js"></script>
</body>

</html>
