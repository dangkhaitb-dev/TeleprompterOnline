---
layout: home-base.njk
permalink: /about.html
pageKey: about
lang: en
---
{%- set pageData = i18nPages['about']['en'] -%}
{%- set chrome = i18nPages['index']['en'] -%}
{%- from "partials/logo.njk" import brandLogo -%}
{%- set logoSvg = brandLogo('currentColor') -%}

<!-- NAV -->
<header class="nav">
    <div class="nav-inner">
        <div class="nav-left">
            <a href="/" class="brand" aria-label="SolPrompter home">{{ logoSvg | safe }}<span class="brand-text">SolPrompter</span></a>
            <nav class="nav-menu" aria-label="Primary">
                {%- for item in chrome.nav.items %}
                {%- set navHref = ('/' + item.url) if '#' in item.url else item.url %}
                <a href="{{ navHref }}" class="nav-item">{{ item.label }}</a>
                {%- endfor %}
            </nav>
        </div>
        <div class="nav-right">
            <a href="{{ pageData.navCta.url }}" class="btn btn-workspaces">{{ pageData.navCta.label }}</a>
            <button type="button" class="nav-toggle" id="navToggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobileNav">
                <span class="nav-toggle-bar"></span>
                <span class="nav-toggle-bar"></span>
                <span class="nav-toggle-bar"></span>
            </button>
        </div>
    </div>
</header>

<!-- MOBILE NAV DRAWER -->
<div class="mobile-nav-scrim" id="mobileNavScrim"></div>
<nav class="mobile-nav" id="mobileNav" aria-label="Mobile navigation">
    <div class="mobile-nav-head">
        <span class="mobile-nav-title">{{ chrome.footer.brand }}</span>
        <button type="button" class="mobile-nav-close" id="mobileNavClose" aria-label="Close menu">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
    </div>
    <ul class="mobile-nav-list">
        {%- for item in chrome.nav.items %}
        {%- set navHref = ('/' + item.url) if '#' in item.url else item.url %}
        <li><a href="{{ navHref }}" class="mobile-nav-link">{{ item.label }}</a></li>
        {%- endfor %}
    </ul>
    <a href="{{ pageData.navCta.url }}" class="btn btn-workspaces mobile-nav-cta">{{ pageData.navCta.label }}</a>
</nav>

<!-- ABOUT STORY -->
<main class="about-page" id="main" tabindex="-1">
    {%- set finalCta = pageData.finalCta %}
    {%- set differences = pageData.differences %}
    <section class="about-hero">
        <div class="about-shell about-hero-grid">
            <div class="about-hero-heading">
                <p class="about-kicker">{{ pageData.hero.eyebrow }}</p>
                <h1 class="about-hero-title">{{ pageData.hero.title }}</h1>
            </div>

            <div class="about-hero-copy">
                <p>{{ pageData.hero.description }}</p>
                <a class="about-text-link" href="{{ finalCta.cta.url }}">
                    {{ finalCta.cta.label }}
                    <span aria-hidden="true">↗</span>
                </a>
            </div>
        </div>
    </section>

    {%- set why = pageData.why %}
    <section class="about-section about-origin" id="why">
        <div class="about-shell about-origin-grid">
            <header class="about-section-heading">
                <p class="about-kicker">{{ why.eyebrow }}</p>
                <h2>{{ why.title }}</h2>
            </header>
            <div class="about-origin-copy">
                {%- for paragraph in why.paragraphs %}
                <p{% if loop.index == 2 %} class="about-origin-belief"{% endif %}>{{ paragraph }}</p>
                {%- endfor %}
            </div>
        </div>
    </section>

    {%- set mission = pageData.mission %}
    <section class="about-section about-mission" id="mission">
        <div class="about-shell">
            <div class="about-section-intro">
                <header class="about-section-heading">
                    <p class="about-kicker">{{ mission.eyebrow }}</p>
                    <h2>{{ mission.title }}</h2>
                </header>
                <p>{{ mission.description }}</p>
            </div>
            <ol class="about-numbered-list">
                {%- for item in mission.items %}
                <li>
                    <span class="about-number">0{{ loop.index }}</span>
                    <h3>{{ item.title }}</h3>
                    <p>{{ item.description }}</p>
                </li>
                {%- endfor %}
            </ol>
        </div>
    </section>

    <section class="about-section about-product" id="different">
        <div class="about-shell">
            <div class="about-product-heading">
                <p class="about-kicker">{{ differences.eyebrow }}</p>
                <h2>{{ differences.title }}</h2>
                <p>{{ differences.description }}</p>
            </div>
            <ol class="about-feature-list">
                {%- for item in differences.items %}
                <li>
                    <span class="about-feature-index">0{{ loop.index }}</span>
                    <div>
                        <h3>{{ item.title }}</h3>
                        <p>{{ item.description }}</p>
                    </div>
                </li>
                {%- endfor %}
            </ol>
        </div>
    </section>

    {%- set principles = pageData.principles %}
    <section class="about-section about-principles" id="principles">
        <div class="about-shell about-principles-grid">
            <header class="about-section-heading">
                <p class="about-kicker">{{ principles.eyebrow }}</p>
                <h2>{{ principles.title }}</h2>
            </header>
            <ol class="about-principle-list">
                {%- for item in principles.items %}
                <li>
                    <span>0{{ loop.index }}</span>
                    <div>
                        <h3>{{ item.title }}</h3>
                        <p>{{ item.description }}</p>
                    </div>
                </li>
                {%- endfor %}
            </ol>
        </div>
    </section>

    {%- set audiences = pageData.audiences %}
    <section class="about-section about-audience" id="audience">
        <div class="about-shell">
            <div class="about-section-intro">
                <header class="about-section-heading">
                    <p class="about-kicker">{{ audiences.eyebrow }}</p>
                    <h2>{{ audiences.title }}</h2>
                </header>
                <p>{{ audiences.description }}</p>
            </div>
            <ul class="about-audience-list">
                {%- for item in audiences.items %}
                <li>
                    <h3>{{ item.title }}</h3>
                    <p>{{ item.description }}</p>
                </li>
                {%- endfor %}
            </ul>
        </div>
    </section>

    {%- set commitment = pageData.commitment %}
    {%- set future = pageData.future %}
    {%- set ecosystem = pageData.ecosystem %}
    <section class="about-section about-roadmap" id="future">
        <div class="about-shell">
            <h2 class="visually-hidden">{{ future.title }}</h2>
            <div class="about-roadmap-chapters">
                <article id="commitment">
                    <p class="about-kicker">{{ commitment.eyebrow }}</p>
                    <h3>{{ commitment.title }}</h3>
                    <div>
                        {%- for paragraph in commitment.paragraphs %}
                        <p>{{ paragraph }}</p>
                        {%- endfor %}
                    </div>
                </article>
                <article>
                    <p class="about-kicker">{{ future.eyebrow }}</p>
                    <h3>{{ future.title }}</h3>
                    <div>
                        {%- for paragraph in future.paragraphs %}
                        <p>{{ paragraph }}</p>
                        {%- endfor %}
                    </div>
                </article>
                <article id="ecosystem">
                    <p class="about-kicker">{{ ecosystem.eyebrow }}</p>
                    <h3>{{ ecosystem.title }}</h3>
                    <div>
                        {%- for paragraph in ecosystem.paragraphs %}
                        <p>{{ paragraph }}</p>
                        {%- endfor %}
                    </div>
                </article>
            </div>
        </div>
    </section>

    <section class="about-final" id="start">
        <div class="about-shell about-final-grid">
            <div>
                <p class="about-kicker">{{ finalCta.eyebrow }}</p>
                <h2>{{ finalCta.title }}</h2>
            </div>
            <div class="about-final-copy">
                <p>{{ finalCta.description }}</p>
                <a class="btn about-final-cta" href="{{ finalCta.cta.url }}">{{ finalCta.cta.label }}</a>
                <p class="about-final-support">{{ finalCta.supporting }}</p>
            </div>
        </div>
    </section>
</main>

<!-- FOOTER -->
<footer class="footer">
    <div class="footer-inner">
        <div class="footer-top">
            <div class="footer-brand">
                <a href="/" class="brand" aria-label="SolPrompter home">{{ logoSvg | safe }}<span class="footer-logo-text">{{ chrome.footer.brand }}</span></a>
                <p class="footer-desc">{{ chrome.footer.description }}</p>
            </div>
            <div class="footer-cols">
                {%- for column in chrome.footer.columns %}
                <div class="footer-col">
                    <h3 class="footer-col-title">{{ column.title }}</h3>
                    <ul class="footer-col-links">
                        {%- for link in column.links %}
                        {%- set footerHref = ('/' + link.url) if '#' in link.url else link.url %}
                        <li><a href="{{ footerHref }}" class="footer-link">{{ link.label }}</a></li>
                        {%- endfor %}
                    </ul>
                </div>
                {%- endfor %}
            </div>
        </div>
        <div class="footer-bottom">
            <p class="footer-copyright">{{ chrome.footer.copyright }}</p>
        </div>
    </div>
</footer>
