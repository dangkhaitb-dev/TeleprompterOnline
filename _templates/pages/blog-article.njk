---
layout: blog-article-base.njk
pagination:
  data: blogArticles
  size: 1
  alias: article
permalink: /blog/{% if article.flatUrl %}{{ article.slug }}{% else %}{{ article.categorySlug }}/{{ article.slug }}{% endif %}/index.html
lang: en
---
<!-- Generated from _templates/_data/articles/*.json. Do not edit this file directly. -->
{%- set pageData = i18nPages['blog'][lang] or i18nPages['blog']['en'] -%}
{%- set canonical = site.url + '/blog/' + (article.slug if article.flatUrl else article.categorySlug + '/' + article.slug) + '/' -%}
{%- from "partials/logo.njk" import brandLogo -%}
{%- set logoSvg = brandLogo('currentColor') -%}

<a class="skip-link" href="#article-content">{{ pageData.skipToArticle }}</a>

<header class="nav article-nav">
    <div class="nav-inner">
        <div class="nav-left">
            <a href="/" class="brand" aria-label="SolPrompter home">{{ logoSvg | safe }}<span class="brand-text">SolPrompter</span></a>
            <nav class="nav-menu" aria-label="Primary">
                {%- for item in pageData.nav.items %}
                <a href="{{ item.url }}" class="nav-item{% if item.label == 'Blog' %} nav-item-current{% endif %}"{% if item.label == 'Blog' %} aria-current="page"{% endif %}>{{ item.label }}</a>
                {%- endfor %}
            </nav>
        </div>
        <div class="nav-right">
            <a href="{{ pageData.nav.cta.url }}" class="btn btn-workspaces">{{ pageData.nav.cta.label }}</a>
        </div>
    </div>
</header>

<main data-root-main data-simple="true" class="article-main">
    <article class="article-content" id="article-content">
        <header class="article-header">
            <nav class="article-breadcrumb" aria-label="{{ pageData.breadcrumbLabel }}">
                <a href="/blog">{{ pageData.breadcrumb.blog }}</a>
                <span aria-hidden="true">/</span>
                <a href="/blog/{{ article.categorySlug }}/">{{ article.category }}</a>
            </nav>
            <h1 class="article-title">{{ article.title }}</h1>
            <p class="article-answer">{{ article.answer }}</p>
            <p class="article-review">
                {{ pageData.review.reviewedBy }} <strong>{{ article.review.by }}</strong>
                <span aria-hidden="true">·</span>
                {{ pageData.review.updated }} <time datetime="{{ article.modified }}">{{ article.review.updatedDisplay }}</time>
            </p>
            <a href="{{ article.cta.url }}" class="article-cta">{{ article.cta.label }}</a>
        </header>

        <div class="article-body">
            {%- set home = site.url + "/" -%}
            <script type="application/ld+json">
                {
                    "@context": "https://schema.org",
                    "@graph": [
                        {
                            "@type": "BlogPosting",
                            "@id": "{{ canonical }}#article",
                            "mainEntityOfPage": { "@id": "{{ canonical }}#webpage" },
                            "headline": "{{ article.title | jsonString | safe }}",
                            "description": "{{ article.seo.description | jsonString | safe }}",
                            "image": { "@id": "{{ canonical }}#primaryimage" },
                            "datePublished": "{{ article.date }}",
                            "dateModified": "{{ article.modified }}",
                            "author": {
                                "@type": "{{ article.author.type }}",
                                "name": "{{ article.author.name | jsonString | safe }}",
                                "url": "{{ site.url }}{{ article.author.url }}"
                            },
                            "publisher": {
                                "@type": "Organization",
                                "@id": "{{ home }}#organization",
                                "name": "{{ site.name }}",
                                "url": "{{ home }}"
                            },
                            "articleSection": "{{ (article.category or 'Product') | jsonString | safe }}",
                            {%- if article.keywords %}
                            "keywords": [{% for k in article.keywords %}"{{ k | jsonString | safe }}"{% if not loop.last %}, {% endif %}{% endfor %}],
                            {%- endif %}
                            {%- if article.mentions %}
                            "mentions": [{% for m in article.mentions %}{ "@type": "Thing", "name": "{{ m | jsonString | safe }}" }{% if not loop.last %}, {% endif %}{% endfor %}],
                            {%- endif %}
                            "about": { "@id": "{{ home }}#application" },
                            "isPartOf": { "@id": "{{ site.url }}/blog#blog" },
                            "breadcrumb": { "@id": "{{ canonical }}#breadcrumb" },
                            "inLanguage": "en"
                        },
                        {
                            "@type": "WebPage",
                            "@id": "{{ canonical }}#webpage",
                            "url": "{{ canonical }}",
                            "name": "{{ article.seo.title | jsonString | safe }}",
                            "isPartOf": { "@id": "{{ home }}#website" },
                            "about": { "@id": "{{ home }}#application" },
                            "primaryImageOfPage": { "@id": "{{ canonical }}#primaryimage" },
                            "breadcrumb": { "@id": "{{ canonical }}#breadcrumb" },
                            "datePublished": "{{ article.date }}",
                            "dateModified": "{{ article.modified }}",
                            "inLanguage": "en"
                        },
                        {
                            "@type": "ImageObject",
                            "@id": "{{ canonical }}#primaryimage",
                            "url": "{{ article.seo.image }}",
                            "contentUrl": "{{ article.seo.image }}",
                            "width": "{{ article.hero.width }}",
                            "height": "{{ article.hero.height }}",
                            "caption": "{{ article.hero.alt | jsonString | safe }}"
                        },
                        {
                            "@type": "BreadcrumbList",
                            "@id": "{{ canonical }}#breadcrumb",
                            "itemListElement": [
                                { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ home }}" },
                                { "@type": "ListItem", "position": 2, "name": "Blog", "item": "{{ site.url }}/blog" },
                                { "@type": "ListItem", "position": 3, "name": "{{ article.category | jsonString | safe }}", "item": "{{ site.url }}/blog/{{ article.categorySlug }}/" },
                                { "@type": "ListItem", "position": 4, "name": "{{ (article.shortName or article.title) | jsonString | safe }}", "item": "{{ canonical }}" }
                            ]
                        }
                    ]
                }
            </script>

            <div class="article-prose">
                {%- for block in article.content %}
                    {%- if block.type == 'paragraph' %}
                    <p>{{ block.html | safe }}</p>
                    {% elif block.type == 'heading' and block.level == 3 %}
                    <h3 id="{{ block.id }}">{{ block.headingHtml | safe }}</h3>
                    {% elif block.type == 'heading' %}
                    <h2 id="{{ block.id }}">{{ block.headingHtml | safe }}</h2>
                    {% elif block.type == 'toc' %}
                    <nav class="article-toc" aria-labelledby="article-toc-title">
                        <p class="article-toc-title" id="article-toc-title">{{ block.title }}</p>
                        <ol class="article-toc-list">
                            {%- for item in article.tocItems %}
                            <li class="article-toc-item">
                                <a href="#{{ item.id }}">{{ item.text }}</a>
                                {%- if item.children.length %}
                                <ol class="article-toc-sublist">
                                    {%- for child in item.children %}
                                    <li><a href="#{{ child.id }}">{{ child.text }}</a></li>
                                    {%- endfor %}
                                </ol>
                                {%- endif %}
                            </li>
                            {%- endfor %}
                        </ol>
                    </nav>
                    {%- elif block.type == 'quote' %}
                    <blockquote><p>{{ block.text | safe }}</p></blockquote>
                    {% elif block.type == 'code' %}
                    <pre class="article-code-example"><code>{{ block.text }}</code></pre>
                    {% elif block.type == 'list' and block.style == 'principles' %}
                    <ul class="article-principles">
                        {%- for item in block.items %}
                        <li>
                            {% if item.title %}<strong>{{ item.title }}</strong>{% endif %}
                            <span>{{ item.text | safe }}</span>
                        </li>
                        {%- endfor %}
                    </ul>
                    {% elif block.type == 'list' %}
                    <ul class="article-bullets">
                        {%- for item in block.items %}
                        <li>{% if item.title %}<strong>{{ item.title }}:</strong> {% endif %}{{ item.text | safe }}</li>
                        {%- endfor %}
                    </ul>
                    {% elif block.type == 'image' %}
                    <figure class="article-inline-figure">
                        <img src="{{ block.src }}" width="{{ block.width }}" height="{{ block.height }}" alt="{{ block.alt }}" loading="lazy" decoding="async">
                        {% if block.caption %}<figcaption>{{ block.caption }}</figcaption>{% endif %}
                    </figure>
                    {% elif block.type == 'endnote' %}
                    <aside class="article-endnote" aria-label="Article navigation">
                        <p>{{ block.text }}</p>
                        <a href="{{ block.url }}">{{ block.label }}</a>
                    </aside>
                    {% endif %}
                {%- endfor %}
            </div>
        </div>
    </article>
</main>

<footer class="footer article-footer">
    <div class="footer-inner">
        <div class="footer-logo">
            <a href="/" class="brand" aria-label="SolPrompter home">{{ logoSvg | safe }}<span class="footer-logo-text">SolPrompter</span></a>
        </div>
        <div class="footer-links">
            {%- for link in pageData.footer.links %}
            <a href="{{ link.url }}" class="footer-link{% if link.label == 'Blog' %} footer-link-current{% endif %}"{% if link.label == 'Blog' %} aria-current="page"{% endif %}>{{ link.label }}</a>
            {%- endfor %}
        </div>
        <div class="footer-copyright">{{ pageData.footer.copyright }}</div>
    </div>
</footer>
