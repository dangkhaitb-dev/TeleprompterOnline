---
layout: blog-base.njk
pagination:
  data: blogCategoryPages
  size: 1
  alias: category
permalink: /blog/{{ category.slug }}/index.html
pageKey: blog
lang: en
---
<!-- Generated from _templates/_data/articles/*.json. Do not edit this file directly. -->
{%- set pageData = i18nPages[pageKey][lang] or i18nPages[pageKey]['en'] -%}
{%- from "partials/logo.njk" import brandLogo -%}
{%- from "partials/blog-listing.njk" import blogListing -%}
{%- set logoSvg = brandLogo('currentColor') -%}

<a class="skip-link" href="#main">{{ pageData.skipToArticles }}</a>

<header class="nav blog-nav">
    <div class="nav-inner">
        <div class="nav-left">
            <a href="/" class="brand" aria-label="SolPrompter home">{{ logoSvg | safe }}<span class="brand-text">SolPrompter</span></a>
            <nav class="nav-menu" aria-label="Primary">
                {%- for item in pageData.nav.items %}
                <a href="{{ item.url }}" class="nav-item{% if item.label == 'Blog' %} nav-item-current{% endif %}"{% if item.label == 'Blog' %} aria-current="page"{% endif %}>{{ item.label }}</a>
                {%- endfor %}
            </nav>
        </div>
        <div class="nav-right">
            <a href="{{ pageData.nav.cta.url }}" class="btn btn-workspaces">{{ pageData.nav.cta.label }}</a>
        </div>
    </div>
</header>

<main id="main" class="blog-main" tabindex="-1">
    <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "CollectionPage",
            "@id": "{{ site.url }}/blog/{{ category.slug }}/#collection",
            "name": "{{ category.name | jsonString | safe }}",
            "description": "{{ pageData.seo.categoryDescriptionPrefix | jsonString | safe }}{{ category.name | jsonString | safe }}{{ pageData.seo.categoryDescriptionSuffix | jsonString | safe }}",
            "url": "{{ site.url }}/blog/{{ category.slug }}/",
            "isPartOf": { "@id": "{{ site.url }}/blog/#blog" },
            "mainEntity": {
                "@type": "ItemList",
                "itemListElement": [
                    {%- for article in category.articles %}
                    {
                        "@type": "ListItem",
                        "position": {{ loop.index }},
                        "url": "{{ site.url }}{{ article.url }}",
                        "name": "{{ article.title | jsonString | safe }}"
                    }{% if not loop.last %},{% endif %}
                    {%- endfor %}
                ]
            }
        }
    </script>

    <section class="blog-category-hero" aria-labelledby="category-heading">
        <div class="blog-category-hero-inner">
            <a class="blog-back-link" href="/blog">← {{ pageData.category.backLabel }}</a>
            <p class="blog-eyebrow">{{ pageData.category.eyebrow }}</p>
            <h1 id="category-heading" class="blog-category-heading">{{ category.name }}</h1>
            <p class="blog-category-intro">{{ pageData.category.descriptionPrefix }}{{ category.name }}{{ pageData.category.descriptionSuffix }}</p>
        </div>
    </section>

    <nav class="blog-category-nav" aria-label="{{ pageData.categoriesLabel }}">
        <div class="blog-category-nav-inner">
            <a class="blog-category-nav-link" href="/blog">
                {{ pageData.allArticles }} <span>{{ blogArticles.length }}</span>
            </a>
            {%- for categoryItem in blogCategories %}
            <a class="blog-category-nav-link{% if categoryItem.slug == category.slug %} is-current{% endif %}" href="/blog/{{ categoryItem.slug }}/"{% if categoryItem.slug == category.slug %} aria-current="page"{% endif %}>
                {{ categoryItem.name }} <span>{{ categoryItem.articles.length }}</span>
            </a>
            {%- endfor %}
        </div>
    </nav>

    <section class="blog-posts-section" aria-labelledby="articles-heading">
        <h2 id="articles-heading" class="blog-section-heading">{{ pageData.articlesHeading }}</h2>
        {{- blogListing(category.articles, pageData) -}}
    </section>
</main>

<footer class="footer blog-footer">
    <div class="footer-inner">
        <div class="footer-logo">
            <a href="/" class="brand" aria-label="SolPrompter home">{{ logoSvg | safe }}<span class="footer-logo-text">SolPrompter</span></a>
            <span class="footer-version">{{ pageData.footer.version }}</span>
        </div>
        <div class="footer-links">
            {%- for link in pageData.footer.links %}
            <a href="{{ link.url }}" class="footer-link{% if link.label == 'Blog' %} footer-link-current{% endif %}"{% if link.label == 'Blog' %} aria-current="page"{% endif %}>{{ link.label }}</a>
            {%- endfor %}
        </div>
        <div class="footer-copyright">{{ pageData.footer.copyright }}</div>
    </div>
</footer>
