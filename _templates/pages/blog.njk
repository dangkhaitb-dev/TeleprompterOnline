---
layout: blog-base.njk
permalink: /blog.html
pageKey: blog
lang: en
---
{%- set pageData = i18nPages[pageKey][lang] or i18nPages[pageKey]['en'] -%}
{%- from "partials/logo.njk" import brandLogo -%}
{%- from "partials/social-links.njk" import socialLinks -%}
{%- from "partials/blog-listing.njk" import blogListing -%}
{%- set logoSvg = brandLogo('currentColor') -%}

<a class="skip-link" href="#main">{{ pageData.skipToArticles }}</a>

<header class="nav blog-nav">
    <div class="nav-inner">
        <div class="nav-left">
            <a href="/" class="brand" aria-label="SolPrompter home">{{ logoSvg | safe }}<span class="brand-text">SolPrompter</span></a>
            <nav class="nav-menu" aria-label="Primary">
                {%- for item in pageData.nav.items %}
                <a href="{{ item.url }}" class="nav-item{% if item.label == 'Blog' %} nav-item-current{% endif %}"{% if item.label == 'Blog' %} aria-current="page"{% endif %}>{{ item.label }}</a>
                {%- endfor %}
            </nav>
        </div>
        <div class="nav-right">
            <a href="{{ pageData.nav.cta.url }}" class="btn btn-workspaces">{{ pageData.nav.cta.label }}</a>
        </div>
    </div>
</header>

<main id="main" class="blog-main" tabindex="-1">
    <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "Blog",
            "@id": "{{ site.url }}/blog#blog",
            "name": "{{ pageData.hero.heading | jsonString | safe }}",
            "description": "{{ pageData.seo.description | jsonString | safe }}",
            "url": "{{ site.url }}/blog",
            "inLanguage": "en-US",
            "publisher": {
                "@type": "Organization",
                "@id": "{{ site.url }}/about#organization",
                "name": "{{ site.name }}",
                "url": "{{ site.url }}/about"
            },
            "blogPost": [
                {%- for article in blogArticles %}
                {
                    "@type": "BlogPosting",
                    "@id": "{{ site.url }}{{ article.url }}#article",
                    "headline": "{{ article.title | jsonString | safe }}",
                    "description": "{{ article.seo.description | jsonString | safe }}",
                    "url": "{{ site.url }}{{ article.url }}",
                    "image": "{{ article.seo.image }}",
                    "datePublished": "{{ article.date }}",
                    "dateModified": "{{ article.modified }}",
                    "author": {
                        "@type": "{{ article.author.type }}",
                        "@id": "{{ site.url }}/about#organization",
                        "name": "{{ article.author.name | jsonString | safe }}",
                        "url": "{{ site.url }}{{ article.author.url }}"
                    },
                    "publisher": { "@id": "{{ site.url }}/about#organization" }
                }{% if not loop.last %},{% endif %}
                {%- endfor %}
            ]
        }
    </script>
    <section class="blog-hero" aria-labelledby="blog-heading">
        <div class="blog-hero-inner">
            <p class="blog-eyebrow">{{ pageData.hero.eyebrow }}</p>
            <div class="blog-hero-copy">
                <h1 id="blog-heading" class="blog-heading">{{ pageData.hero.heading }}</h1>
                <p class="blog-intro">{{ pageData.hero.description }}</p>
            </div>
        </div>
    </section>

    <nav class="blog-category-nav" aria-label="{{ pageData.categoriesLabel }}">
        <div class="blog-category-nav-inner">
            <a class="blog-category-nav-link is-current" href="/blog" aria-current="page">
                {{ pageData.allArticles }} <span>{{ blogArticles.length }}</span>
            </a>
            {%- for category in blogCategories %}
            <a class="blog-category-nav-link" href="/blog/{{ category.slug }}/">
                {{ category.name }} <span>{{ category.articles.length }}</span>
            </a>
            {%- endfor %}
        </div>
    </nav>

    <section class="blog-posts-section" aria-labelledby="articles-heading">
        <h2 id="articles-heading" class="blog-section-heading">{{ pageData.articlesHeading }}</h2>
        {{- blogListing(blogArticles, pageData) -}}
    </section>
</main>

<footer class="footer blog-footer">
    <div class="footer-inner">
        <div class="footer-logo">
            <a href="/" class="brand" aria-label="SolPrompter home">{{ logoSvg | safe }}<span class="footer-logo-text">SolPrompter</span></a>
            <span class="footer-version">{{ pageData.footer.version }}</span>
        </div>
        <div class="footer-links">
            {%- for link in pageData.footer.links %}
            <a href="{{ link.url }}" class="footer-link{% if link.label == 'Blog' %} footer-link-current{% endif %}"{% if link.label == 'Blog' %} aria-current="page"{% endif %}>{{ link.label }}</a>
            {%- endfor %}
        </div>
        {{ socialLinks(site.social) }}
        <div class="footer-copyright">{{ pageData.footer.copyright }}</div>
    </div>
</footer>
