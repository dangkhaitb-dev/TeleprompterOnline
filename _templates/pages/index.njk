---
layout: home-base.njk
pagination:
  data: indexPages
  size: 1
  alias: pageInfo
eleventyComputed:
  permalink: "{{ pageInfo.permalink }}"
  pageKey: "{{ pageInfo.pageKey }}"
  lang: "{{ pageInfo.lang }}"
---
{%- set pageData = i18nPages[pageKey][lang] or i18nPages[pageKey]['en'] -%}
{%- from "partials/logo.njk" import brandLogo -%}
{%- set logoSvg = brandLogo('currentColor') -%}

<!-- NAV -->
<header class="nav">
    <div class="nav-inner">
        <div class="nav-left">
            <a href="/" class="brand" tabindex="0" style="height: 100%; opacity: 1; gap: 0.5rem;">
                <div class="shared-brand-logo" aria-hidden="true" style="background-image: url('/logo.webp'); background-size: 100% 100%; width: 21px; height: 21px;"></div>
                <p class="shared-brand-text">SolPrompter</p>
            </a>
            <nav class="nav-menu" aria-label="Primary">
                {%- for item in pageData.nav.items %}
                <a href="{{ item.url }}" class="nav-item">{{ item.label }}</a>
                {%- endfor %}
                {% include "partials/language-switcher.njk" %}
            </nav>
        </div>
        <div class="nav-right">
            <a href="{{ pageData.nav.cta.url }}" class="btn btn-workspaces">{{ pageData.nav.cta.label }}</a>
            <button type="button" class="nav-toggle" id="navToggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobileNav">
                <span class="nav-toggle-bar"></span>
                <span class="nav-toggle-bar"></span>
                <span class="nav-toggle-bar"></span>
            </button>
        </div>
    </div>
</header>

<!-- MOBILE NAV DRAWER -->
<div class="mobile-nav-scrim" id="mobileNavScrim"></div>
<nav class="mobile-nav" id="mobileNav" aria-label="Mobile navigation">
    <div class="mobile-nav-head">
        <span class="mobile-nav-title">{{ pageData.footer.brand }}</span>
        <button type="button" class="mobile-nav-close" id="mobileNavClose" aria-label="Close menu">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
    </div>
    <ul class="mobile-nav-list">
        {%- for item in pageData.nav.items %}
        <li><a href="{{ item.url }}" class="mobile-nav-link">{{ item.label }}</a></li>
        {%- endfor %}
    </ul>
    <a href="{{ pageData.nav.cta.url }}" class="btn btn-workspaces mobile-nav-cta">{{ pageData.nav.cta.label }}</a>
    {% include "partials/language-switcher.njk" %}
</nav>

<!-- HERO + MAIN -->
<main id="main" class="landing-main" tabindex="-1">
    <section class="hero">
        <div class="hero-inner">
            <h1 class="hero-title">{{ pageData.hero.title }}</h1>
            <p class="hero-desc">{{ pageData.hero.subtitle }}</p>

            <div class="main">
                <form class="composer" id="composerForm" novalidate
                      data-msg-empty="{{ pageData.messages.errorEmpty }}"
                      data-msg-read="{{ pageData.messages.errorRead }}">
                    <input type="file" id="file-input" accept=".md,.markdown,.txt" hidden>
                    <div class="textarea-container">
                        <label class="visually-hidden" for="paste-textarea">{{ pageData.hero.placeholder }}</label>
                        <textarea id="paste-textarea" class="editor-textarea" placeholder="{{ pageData.hero.placeholder }}"></textarea>
                    </div>
                    <div class="composer-actions">
                        <button type="button" class="upload-floating-btn" id="upload-btn"
                                aria-label="{{ pageData.hero.uploadLabel }}"
                                title="{{ pageData.hero.uploadLabel }}">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 13v8"/><path d="m8 17 4-4 4 4"/><path d="M20.88 18.09A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.29"/></svg>
                            <span class="btn-label-full">{{ pageData.hero.uploadLabel }}</span>
                            <span class="btn-label-short">{{ pageData.hero.uploadLabelShort }}</span>
                        </button>
                        <button type="submit" class="submit-btn" id="start-btn">
                            <span class="btn-label-full">{{ pageData.hero.startLabel }}</span>
                            <span class="btn-label-short">{{ pageData.hero.startLabelShort }}</span>
                        </button>
                    </div>
                    <p class="error-box" id="paste-error-box" role="alert" hidden></p>
                </form>
            </div>
        </div>
    </section>

    <!-- FEATURES OVERVIEW -->
    {%- set features = pageData.features %}
    <section class="section" id="features">
        <div class="section-inner">
            <div class="section-head">
                <p class="eyebrow">{{ features.eyebrow }}</p>
                <h2 class="section-title">{{ features.title }}</h2>
                <p class="section-desc">{{ features.description }}</p>
            </div>
            <div class="features-editorial-grid">
                {%- for item in features.items %}
                <div class="feature-editorial-item">
                    <h3 class="feature-title">{{ item.title }}</h3>
                    <p class="feature-desc">{{ item.description }}</p>
                </div>
                {%- endfor %}
            </div>
        </div>
    </section>

    <!-- SPOTLIGHT 1: AI VOICE AUTO-SCROLL -->
    {%- set voiceScroll = pageData.voiceScroll %}
    <section class="section section-alt" id="voice-scroll">
        <div class="section-inner split-section">
            <div class="split-text-col">
                <p class="eyebrow">{{ voiceScroll.eyebrow }}</p>
                <h2 class="section-title" style="margin-bottom: 0.5rem;">{{ voiceScroll.title }}</h2>
                {%- if voiceScroll.subTitle -%}
                <p class="section-desc" style="font-weight: 600; font-size: 1.2rem; margin-top: 0; margin-bottom: 1.5rem; color: var(--ink);">{{ voiceScroll.subTitle }}</p>
                {%- endif -%}
                
                {%- if voiceScroll.problemSolution %}
                <div class="problem-solution-box" style="margin-bottom: 2rem; padding: 1.5rem; background: var(--line-soft); border-radius: 12px; border: 1px solid var(--line); width: 100%;">
                    <div class="problem-part" style="margin-bottom: 1rem;">
                        <strong style="color: var(--danger-text); display: block; margin-bottom: 0.25rem;">{{ voiceScroll.problemSolution.problemTitle }}</strong>
                        <p style="font-size: 0.95rem; margin: 0; color: var(--ink-soft); line-height: 1.5;">{{ voiceScroll.problemSolution.problemDesc }}</p>
                    </div>
                    <div class="solution-part">
                        <strong style="color: var(--brand); display: block; margin-bottom: 0.25rem;">{{ voiceScroll.problemSolution.solutionTitle }}</strong>
                        <p style="font-size: 0.95rem; margin: 0; color: var(--ink-soft); line-height: 1.5;">{{ voiceScroll.problemSolution.solutionDesc }}</p>
                    </div>
                </div>
                {%- endif %}

                <p class="section-desc">{{ voiceScroll.description }}</p>
                <ul class="custom-benefits-list">
                    {%- for item in voiceScroll.benefits %}
                    <li>
                        <div class="benefit-info">
                            <strong class="benefit-title">{{ item.title }}</strong>
                            <p class="benefit-desc">{{ item.description }}</p>
                        </div>
                    </li>
                    {%- endfor %}
                </ul>
                <p class="section-support">{{ voiceScroll.supporting }}</p>
                
                {%- if voiceScroll.qa %}
                <div class="inline-qa" style="margin-top: 1.5rem; padding: 1.25rem; background: var(--line-soft); border-radius: 10px; font-size: 0.95rem; width: 100%; border-inline-start: 4px solid var(--brand);">
                    <strong style="display: block; color: var(--ink); margin-bottom: 0.35rem;">Q: {{ voiceScroll.qa.q }}</strong>
                    <p style="margin: 0; color: var(--ink-soft); line-height: 1.5;">{{ voiceScroll.qa.a }}</p>
                </div>
                {%- endif %}
            </div>
            <div class="split-visual-col">
                <div class="browser-frame app-screenshot-wrapper">
                    <div class="browser-chrome">
                        <span class="chrome-dot red"></span>
                        <span class="chrome-dot yellow"></span>
                        <span class="chrome-dot green"></span>
                    </div>
                    <div class="browser-viewport">
                        <img src="/media/teleprompter-screenshot.jpg" alt="SolPrompter Studio Screen" class="app-screenshot">
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- SPOTLIGHT 2: NOTCH & REMOTE -->
    {%- set notch = pageData.notch %}
    {%- set remote = pageData.remote %}
    <section class="section" id="notch">
        <div class="section-inner">
            <div class="section-head">
                <p class="eyebrow">{{ notch.eyebrow }}</p>
                <h2 class="section-title">{{ notch.title }}</h2>
                <p class="section-desc">{{ notch.description }}</p>
            </div>
            
            <div class="spotlight-grid">
                <!-- Left: Notch Mode -->
                <div class="spotlight-col">
                    <div class="spotlight-text-block">
                        <ul class="modern-checklist">
                            {%- for point in notch.items %}
                            <li>
                                <span class="check-bullet">•</span>
                                <span class="check-text">{{ point }}</span>
                            </li>
                            {%- endfor %}
                        </ul>
                        <p class="section-support" style="margin-top: 1.5rem;">{{ notch.supporting }}</p>
                    </div>
                    <div class="split-visual-col" style="margin-top: 2rem;">
                        <div class="browser-frame app-screenshot-wrapper">
                            <div class="browser-chrome">
                                <span class="chrome-dot red"></span>
                                <span class="chrome-dot yellow"></span>
                                <span class="chrome-dot green"></span>
                            </div>
                            <div class="browser-viewport">
                                <img src="/media/notch-screenshot.jpg" alt="SolPrompter Notch Mode Screen" class="app-screenshot">
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right: Remote Control -->
                <div class="spotlight-col" id="remote">
                    <div class="spotlight-text-block">
                        <h3 class="spotlight-subtitle">{{ remote.title }}</h3>
                        <p class="section-desc" style="margin-top: 0;">{{ remote.description }}</p>
                        <ul class="custom-benefits-list">
                            {%- for item in remote.items %}
                            <li>
                                <div class="benefit-info">
                                    <strong class="benefit-title">{{ item.title }}</strong>
                                    <p class="benefit-desc">{{ item.description }}</p>
                                </div>
                            </li>
                            {%- endfor %}
                        </ul>
                        <p class="section-support" style="margin-top: 1.5rem;">{{ remote.supporting }}</p>
                        
                        {%- if remote.qa %}
                        <div class="inline-qa" style="margin-top: 1.5rem; padding: 1.25rem; background: var(--line-soft); border-radius: 10px; font-size: 0.95rem; width: 100%; border-inline-start: 4px solid var(--brand);">
                            <strong style="display: block; color: var(--ink); margin-bottom: 0.35rem;">Q: {{ remote.qa.q }}</strong>
                            <p style="margin: 0; color: var(--ink-soft); line-height: 1.5;">{{ remote.qa.a }}</p>
                        </div>
                        {%- endif %}
                    </div>
                    <div class="split-visual-col" style="margin-top: 2rem;">
                        <div class="remote-phone-visual">
                            <svg class="remote-phone-svg" viewBox="0 0 280 570" role="img" aria-labelledby="remotePhoneTitle remotePhoneDesc">
                                <title id="remotePhoneTitle">SolPrompter mobile remote control</title>
                                <desc id="remotePhoneDesc">An iPhone-shaped remote interface with a script preview, playback, speed, navigation, and recording controls.</desc>
                                <rect x="4" y="4" width="272" height="562" rx="56" fill="#111214"/>
                                <rect x="12" y="12" width="256" height="546" rx="48" fill="#232427" stroke="#3a3b3f" stroke-width="2"/>
                                <rect x="22" y="22" width="236" height="526" rx="39" fill="#0f1012"/>
                                <rect x="103" y="29" width="74" height="23" rx="12" fill="#050505"/>
                                <text x="39" y="45" fill="#f5f5f7" font-family="system-ui, -apple-system, sans-serif" font-size="10" font-weight="600">9:41</text>
                                <path d="M221 37h3v7h-3zM226 34h3v10h-3zM231 31h3v13h-3z" fill="#f5f5f7"/>
                                <rect x="239" y="34" width="12" height="9" rx="2" fill="none" stroke="#f5f5f7" stroke-width="1.2"/>
                                <rect x="241" y="36" width="8" height="5" rx="1" fill="#f5f5f7"/>

                                <text x="38" y="88" fill="#f5f5f7" font-family="system-ui, -apple-system, sans-serif" font-size="16" font-weight="650">Remote</text>
                                <circle cx="221" cy="82" r="4" fill="#75dd28"/>
                                <text x="230" y="86" fill="#a9aaae" font-family="system-ui, -apple-system, sans-serif" font-size="9">Live</text>

                                <rect x="34" y="108" width="212" height="132" rx="18" fill="#1a1b1e" stroke="#303136"/>
                                <text x="52" y="132" fill="#8b8d92" font-family="system-ui, -apple-system, sans-serif" font-size="9" font-weight="600" letter-spacing="1.2">SCRIPT PREVIEW</text>
                                <rect x="52" y="151" width="152" height="7" rx="3.5" fill="#4a4b50"/>
                                <rect x="52" y="169" width="176" height="7" rx="3.5" fill="#f5f5f7"/>
                                <rect x="52" y="187" width="132" height="7" rx="3.5" fill="#f5f5f7"/>
                                <rect x="52" y="205" width="164" height="7" rx="3.5" fill="#4a4b50"/>
                                <rect x="46" y="164" width="3" height="35" rx="1.5" fill="#75dd28"/>

                                <circle cx="140" cy="304" r="44" fill="#f5f5f7"/>
                                <path d="M132 287l24 17-24 17z" fill="#111214"/>
                                <text x="140" y="365" text-anchor="middle" fill="#8b8d92" font-family="system-ui, -apple-system, sans-serif" font-size="10" font-weight="600" letter-spacing="1">PLAY SCRIPT</text>

                                <rect x="43" y="389" width="194" height="52" rx="18" fill="#1a1b1e" stroke="#303136"/>
                                <text x="68" y="421" text-anchor="middle" fill="#f5f5f7" font-family="system-ui, -apple-system, sans-serif" font-size="22">−</text>
                                <text x="140" y="411" text-anchor="middle" fill="#8b8d92" font-family="system-ui, -apple-system, sans-serif" font-size="9">SPEED</text>
                                <text x="140" y="429" text-anchor="middle" fill="#f5f5f7" font-family="system-ui, -apple-system, sans-serif" font-size="14" font-weight="650">1.0×</text>
                                <text x="212" y="421" text-anchor="middle" fill="#f5f5f7" font-family="system-ui, -apple-system, sans-serif" font-size="20">+</text>

                                <rect x="43" y="454" width="92" height="42" rx="14" fill="#1a1b1e"/>
                                <rect x="145" y="454" width="92" height="42" rx="14" fill="#1a1b1e"/>
                                <text x="89" y="480" text-anchor="middle" fill="#d7d8db" font-family="system-ui, -apple-system, sans-serif" font-size="11" font-weight="600">Previous</text>
                                <text x="191" y="480" text-anchor="middle" fill="#d7d8db" font-family="system-ui, -apple-system, sans-serif" font-size="11" font-weight="600">Next</text>

                                <rect x="89" y="516" width="102" height="5" rx="2.5" fill="#f5f5f7"/>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- SPOTLIGHT 3: RECORDING & PRIVACY -->
    {%- set recording = pageData.recording %}
    {%- set workspace = pageData.workspace %}
    <section class="section section-alt" id="recording">
        <div class="section-inner">
            <div class="section-head">
                <p class="eyebrow">{{ recording.eyebrow }}</p>
                <h2 class="section-title">{{ recording.title }}</h2>
                <p class="section-desc">{{ recording.description }}</p>
            </div>
            
            <div class="spotlight-grid">
                <!-- Left: Studio Recording -->
                <div class="spotlight-col">
                    <ul class="custom-benefits-list">
                        {%- for item in recording.items %}
                        {% if loop.index <= 4 %}
                        <li>
                            <div class="benefit-info">
                                <strong class="benefit-title">{{ item.title }}</strong>
                                <p class="benefit-desc">{{ item.description }}</p>
                            </div>
                        </li>
                        {% endif %}
                        {%- endfor %}
                    </ul>
                    {%- if recording.qa %}
                    <div class="inline-qa" style="margin-top: 1.5rem; padding: 1.25rem; background: var(--line-soft); border-radius: 10px; font-size: 0.95rem; border-inline-start: 4px solid var(--brand);">
                        <strong style="display: block; color: var(--ink); margin-bottom: 0.35rem;">Q: {{ recording.qa.q }}</strong>
                        <p style="margin: 0; color: var(--ink-soft); line-height: 1.5;">{{ recording.qa.a }}</p>
                    </div>
                    {%- endif %}
                </div>

                <!-- Right: Private Workspace -->
                <div class="spotlight-col" id="workspace">
                    <h3 class="spotlight-subtitle">{{ workspace.title }}</h3>
                    <p class="section-desc" style="margin-top: 0;">{{ workspace.description }}</p>
                    <ul class="custom-benefits-list">
                        {%- for item in workspace.items %}
                        {% if loop.index <= 4 %}
                        <li>
                            <div class="benefit-info">
                                <strong class="benefit-title">{{ item.title }}</strong>
                                <p class="benefit-desc">{{ item.description }}</p>
                            </div>
                        </li>
                        {% endif %}
                        {%- endfor %}
                    </ul>
                    {%- if workspace.qa %}
                    <div class="inline-qa" style="margin-top: 1.5rem; padding: 1.25rem; background: var(--line-soft); border-radius: 10px; font-size: 0.95rem; border-inline-start: 4px solid var(--brand);">
                        <strong style="display: block; color: var(--ink); margin-bottom: 0.35rem;">Q: {{ workspace.qa.q }}</strong>
                        <p style="margin: 0; color: var(--ink-soft); line-height: 1.5;">{{ workspace.qa.a }}</p>
                    </div>
                    {%- endif %}
                </div>
            </div>

            <div class="split-visual-col" style="margin-top: 3.5rem;">
                <div class="browser-frame app-screenshot-wrapper">
                    <div class="browser-chrome">
                        <span class="chrome-dot red"></span>
                        <span class="chrome-dot yellow"></span>
                        <span class="chrome-dot green"></span>
                    </div>
                    <div class="browser-viewport">
                        <img src="/media/workspaces-screenshot.jpg" alt="SolPrompter Workspace Library" class="app-screenshot">
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- HOW IT WORKS -->
    {%- set howItWorks = pageData.howItWorks %}
    <section class="section" id="how-it-works">
        <div class="section-inner">
            <div class="section-head">
                <p class="eyebrow">{{ howItWorks.eyebrow }}</p>
                <h2 class="section-title">{{ howItWorks.title }}</h2>
                <p class="section-desc">{{ howItWorks.description }}</p>
            </div>
            <div class="steps-editorial-flow">
                {%- for step in howItWorks.steps %}
                <div class="step-editorial-item" id="{{ step.anchor }}">
                    <span class="step-num">0{{ loop.index }}</span>
                    <h3 class="step-title">{{ step.title }}</h3>
                    <p class="step-desc">{{ step.description }}</p>
                </div>
                {%- endfor %}
            </div>
        </div>
    </section>

    <!-- USE CASES -->
    {%- set useCases = pageData.useCases %}
    <section class="section section-alt" id="use-cases">
        <div class="section-inner">
            <div class="section-head">
                <p class="eyebrow">{{ useCases.eyebrow }}</p>
                <h2 class="section-title">{{ useCases.title }}</h2>
            </div>
            <div class="use-cases-editorial-grid">
                {%- for item in useCases.items %}
                <div class="use-case-item">
                    <h3 class="use-case-title">{{ item.title }}</h3>
                    <p class="use-case-desc">{{ item.description }}</p>
                </div>
                {%- endfor %}
            </div>
            
            {%- if useCases.platforms %}
            <div class="use-cases-platforms" style="margin-top: 3.5rem; border-top: 1px solid var(--line); padding-top: 2.5rem; text-align: center;">
                <h3 style="font-size: 1.25rem; font-weight: 600; color: var(--ink); margin-bottom: 1.5rem;">{{ useCases.platformsTitle }}</h3>
                <div class="platforms-tags" style="display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; max-width: 50rem; margin: 0 auto;">
                    {%- for platform in useCases.platforms %}
                    <span style="font-size: 0.9rem; font-weight: 500; background: var(--line-soft); color: var(--ink-soft); padding: 0.4rem 1rem; border-radius: 50rem; border: 1px solid var(--line);">{{ platform }}</span>
                    {%- endfor %}
                </div>
            </div>
            {%- endif %}
        </div>
    </section>

    <!-- COMPARISON TABLE -->
    {%- set comparison = pageData.comparison %}
    <section class="section" id="why">
        <div class="section-inner">
            <div class="section-head">
                <p class="eyebrow">{{ comparison.eyebrow }}</p>
                <h2 class="section-title">{{ comparison.title }}</h2>
                <p class="section-desc">{{ comparison.description }}</p>
            </div>
            <div class="comparison-table-wrapper" style="overflow-x: auto; margin-top: 2rem;">
                <table class="comparison-table">
                    <thead>
                        <tr>
                            {%- for header in comparison.table.headers %}
                            <th>{{ header }}</th>
                            {%- endfor %}
                        </tr>
                    </thead>
                    <tbody>
                        {%- for row in comparison.table.rows %}
                        <tr>
                            <td><strong>{{ row.feature }}</strong></td>
                            <td><strong>{{ row.sol }}</strong></td>
                            <td>{{ row.smart }}</td>
                            <td>{{ row.mirror }}</td>
                        </tr>
                        {%- endfor %}
                    </tbody>
                </table>
            </div>

            {%- if comparison.whyChoose %}
            <div class="why-choose-details" style="margin-top: 4rem;">
                <h3 class="section-subtitle" style="text-align: center; margin-bottom: 2rem; font-size: 1.75rem; color: var(--text-heading);">{{ comparison.whyChoose.title }}</h3>
                <div class="why-choose-editorial-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 3rem; margin-top: 2rem;">
                    {%- for item in comparison.whyChoose.items %}
                    <div class="why-choose-item" style="text-align: left;">
                        <h4 style="font-size: 1.25rem; margin-bottom: 0.75rem; color: var(--text-heading); font-weight: 600;">{{ item.title }}</h4>
                        <p style="font-size: 0.95rem; line-height: 1.6; color: var(--text-muted); margin: 0;">{{ item.description }}</p>
                    </div>
                    {%- endfor %}
                </div>
            </div>
            {%- endif %}

            <p class="section-support" style="margin-top: 3rem; text-align: center;">{{ comparison.supporting }}</p>
        </div>
    </section>

    <!-- ABOUT -->
    {%- set about = pageData.about %}
    <section class="section section-alt" id="about">
        <div class="section-inner section-narrow">
            <div class="section-head">
                <p class="eyebrow">{{ about.eyebrow }}</p>
                <h2 class="section-title">{{ about.title }}</h2>
            </div>
            <div class="prose-content">
                {%- for paragraph in about.paragraphs %}
                <p class="prose-paragraph">{{ paragraph }}</p>
                {%- endfor %}
            </div>
        </div>
    </section>

    <!-- ENGINEERING & PERFORMANCE -->
    {%- set engineering = pageData.engineering %}
    {%- if engineering %}
    <section class="section" id="engineering">
        <div class="section-inner">
            <div class="section-head" style="margin-bottom: 3.5rem;">
                <p class="eyebrow">{{ engineering.eyebrow }}</p>
                <h2 class="section-title">{{ engineering.title }}</h2>
                <p class="section-desc">{{ engineering.description }}</p>
            </div>
            
            <div class="spotlight-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 4rem; align-items: flex-start; text-align: left;">
                <!-- Left: Product Principles -->
                <div class="spotlight-col">
                    {%- for item in engineering.principles %}
                    <div class="engineering-principle" style="margin-bottom: 2rem;">
                        <h3 style="font-size: 1.35rem; font-weight: 600; color: var(--ink); margin-bottom: 0.75rem;">{{ item.title }}</h3>
                        <p class="section-desc" style="font-size: 0.95rem; line-height: 1.6; color: var(--ink-soft); margin: 0;">{{ item.description | safe }}</p>
                    </div>
                    {%- endfor %}
                </div>
                
                <!-- Right: Benchmarks -->
                <div class="spotlight-col">
                    <h3 style="font-size: 1.35rem; font-weight: 600; color: var(--ink); margin-bottom: 1.5rem; text-align: center;">{{ engineering.benchmarksTitle }}</h3>
                    <div class="benchmarks-table-wrapper" style="overflow-x: auto; margin-top: 1rem;">
                        <table class="comparison-table" style="width: 100%; border-collapse: collapse; font-size: 0.95rem;">
                            <thead>
                                <tr style="border-bottom: 2px solid var(--ink);">
                                    <th style="text-align: left; padding: 0.75rem 1rem; font-weight: 600;">Metric</th>
                                    <th style="text-align: center; padding: 0.75rem 1rem; font-weight: 600;">SolPrompter</th>
                                    <th style="text-align: center; padding: 0.75rem 1rem; font-weight: 600;">Traditional</th>
                                </tr>
                            </thead>
                            <tbody>
                                {%- for row in engineering.benchmarks %}
                                <tr style="border-bottom: 1px solid var(--line-soft);">
                                    <td style="text-align: left; padding: 0.75rem 1rem;"><strong>{{ row.metric }}</strong></td>
                                    <td style="text-align: center; padding: 0.75rem 1rem; color: var(--brand-strong); font-weight: 600;">{{ row.sol }}</td>
                                    <td style="text-align: center; padding: 0.75rem 1rem; color: var(--ink-faint);">{{ row.trad }}</td>
                                </tr>
                                {%- endfor %}
                            </tbody>
                        </table>
                    </div>
                    <p class="section-support" style="font-size: 0.85rem; margin-top: 1.5rem; text-align: center; color: var(--ink-muted);">{{ engineering.benchmarksSupport }}</p>
                </div>
            </div>
        </div>
    </section>
    {%- endif %}

    <!-- FAQ -->
    {%- set faq = pageData.faq %}
    <section class="section" id="faq">
        <div class="section-inner section-narrow">
            <div class="section-head">
                <p class="eyebrow">{{ faq.eyebrow }}</p>
                <h2 class="section-title">{{ faq.title }}</h2>
            </div>
            <div class="faq-container">
                {%- for item in faq.items %}
                <details class="faq-accordion-item" id="{{ item.anchor }}">
                    <summary class="faq-summary">
                        <span class="faq-question-text">{{ item.q }}</span>
                        <svg class="faq-chevron-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                    </summary>
                    <div class="faq-content">
                        <p class="faq-answer-text">{{ item.a | safe }}</p>
                    </div>
                </details>
                {%- endfor %}
            </div>
        </div>
    </section>

    <!-- FINAL CTA -->
    {%- set finalCta = pageData.finalCta %}
    <section class="section section-alt final-cta" id="start">
        <div class="section-inner section-narrow">
            <p class="eyebrow">{{ finalCta.eyebrow }}</p>
            <h2 class="section-title">{{ finalCta.title }}</h2>
            <p class="section-desc">{{ finalCta.description }}</p>
            <div class="section-cta"><a class="btn btn-primary btn-lg" href="{{ finalCta.cta.url }}">{{ finalCta.cta.label }}</a></div>
            <p class="section-support">{{ finalCta.supporting }}</p>
        </div>
    </section>
</main>

<!-- FOOTER -->
<footer class="footer">
    <div class="footer-inner">
        <div class="footer-top">
            <div class="footer-brand">
                <a href="/" class="brand" aria-label="SolPrompter home">{{ logoSvg | safe }}<span class="footer-logo-text">{{ pageData.footer.brand }}</span></a>
                <p class="footer-desc">{{ pageData.footer.description }}</p>
            </div>
            <div class="footer-cols">
                {%- for column in pageData.footer.columns %}
                <div class="footer-col">
                    <h3 class="footer-col-title">{{ column.title }}</h3>
                    <ul class="footer-col-links">
                        {%- for link in column.links %}
                        <li><a href="{{ link.url }}" class="footer-link">{{ link.label }}</a></li>
                        {%- endfor %}
                    </ul>
                </div>
                {%- endfor %}
            </div>
        </div>
        <div class="footer-bottom">
            <p class="footer-copyright">{{ pageData.footer.copyright }}</p>
        </div>
    </div>
</footer>

<!-- DRAG OVERLAY -->
<div class="drag-overlay" id="drag-overlay" aria-hidden="true" hidden>
    <div class="drag-overlay-content">
        <svg class="drag-overlay-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 13v8"/><path d="m8 17 4-4 4 4"/><path d="M20.88 18.09A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.29"/></svg>
        <h2>{{ pageData.hero.dropTitle }}</h2>
        <p>{{ pageData.hero.dropHint }}</p>
    </div>
</div>
