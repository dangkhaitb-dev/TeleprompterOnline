---
layout: home-base.njk
pagination:
  data: indexPages
  size: 1
  alias: pageInfo
eleventyComputed:
  permalink: "{{ pageInfo.permalink }}"
  pageKey: "{{ pageInfo.pageKey }}"
  lang: "{{ pageInfo.lang }}"
---
{%- set pageData = i18nPages[pageKey][lang] or i18nPages[pageKey]['en'] -%}
{%- from "partials/logo.njk" import brandLogo -%}
{%- set logoSvg = brandLogo('currentColor') -%}

<!-- NAV -->
<header class="nav">
    <div class="nav-inner">
        <div class="nav-left">
            <a href="/" class="brand framer-WFgEA framer-qdeek2 framer-v-qdeek2 framer-4n26gx" data-framer-name="On" data-highlight="true" data-framer-page-link-current="true" tabindex="0" style="height: 100%; opacity: 1; gap: 0.5rem;"><div data-framer-component-type="SVG" parentsize="0" _constraints="[object Object]" rotation="0" shadows="" class="framer-ngytjn shared-brand-logo" aria-hidden="true" style="image-rendering: auto; flex-shrink: 0; background-size: 100% 100%; background-image: url('/logo.webp'); opacity: 1; width: 21px; height: 21px;"></div><div class="framer-1gzwofs" data-framer-component-type="RichTextContainer" style="--extracted-2gg91v: &quot;opsz&quot; 32, &quot;wght&quot; 600; --extracted-r6o4lv: rgb(0, 0, 0); --framer-link-text-color: rgb(0, 153, 255); --framer-link-text-decoration: underline; transform: none; opacity: 1;"><p dir="auto" class="framer-text shared-brand-text" style="--font-selector:SW50ZXItVmFyaWFibGVWRj1JbTl3YzNvaUlETXlMQ0FpZDJkb2RDSWdOakF3;--framer-font-family:&quot;Inter Variable&quot;, &quot;Inter Variable Placeholder&quot;, sans-serif;--framer-font-open-type-features:'ss07' on, 'cv05' on, 'ss03' on, 'cv11' on;--framer-font-size:14px;--framer-font-variation-axes:var(--extracted-2gg91v, &quot;opsz&quot; 32, &quot;wght&quot; 600);--framer-letter-spacing:-0.01px;--framer-line-height:1em;--framer-text-alignment:left;--framer-text-color:var(--extracted-r6o4lv, rgb(0, 0, 0)); margin: 0;">SolPrompter</p></div></a>
            <nav class="nav-menu" aria-label="Primary">
                {%- for item in pageData.nav.items %}
                <a href="{{ item.url }}" class="nav-item">{{ item.label }}</a>
                {%- endfor %}
                {% include "partials/language-switcher.njk" %}
            </nav>
        </div>
        <div class="nav-right">
            <a href="{{ pageData.nav.cta.url }}" class="btn btn-workspaces">{{ pageData.nav.cta.label }}</a>
            <button type="button" class="nav-toggle" id="navToggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobileNav">
                <span class="nav-toggle-bar"></span>
                <span class="nav-toggle-bar"></span>
                <span class="nav-toggle-bar"></span>
            </button>
        </div>
    </div>
</header>

<!-- MOBILE NAV DRAWER -->
<div class="mobile-nav-scrim" id="mobileNavScrim"></div>
<nav class="mobile-nav" id="mobileNav" aria-label="Mobile navigation">
    <div class="mobile-nav-head">
        <span class="mobile-nav-title">{{ pageData.footer.brand }}</span>
        <button type="button" class="mobile-nav-close" id="mobileNavClose" aria-label="Close menu">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
    </div>
    <ul class="mobile-nav-list">
        {%- for item in pageData.nav.items %}
        <li><a href="{{ item.url }}" class="mobile-nav-link">{{ item.label }}</a></li>
        {%- endfor %}
    </ul>
    <a href="{{ pageData.nav.cta.url }}" class="btn btn-workspaces mobile-nav-cta">{{ pageData.nav.cta.label }}</a>
    {% include "partials/language-switcher.njk" %}
</nav>

<!-- HERO + MAIN -->
<main id="main" tabindex="-1">
    <section class="hero">
        <div class="hero-inner">
            <h1 class="hero-title">{{ pageData.hero.title }}</h1>
            <p class="hero-desc">{{ pageData.hero.subtitle }}</p>

            <div class="main">
                <form class="composer" id="composerForm" novalidate
                      data-msg-empty="{{ pageData.messages.errorEmpty }}"
                      data-msg-read="{{ pageData.messages.errorRead }}">
                    <input type="file" id="file-input" accept=".md,.markdown,.txt" hidden>
                    <div class="textarea-container">
                        <label class="visually-hidden" for="paste-textarea">{{ pageData.hero.placeholder }}</label>
                        <textarea id="paste-textarea" class="editor-textarea" placeholder="{{ pageData.hero.placeholder }}"></textarea>
                    </div>
                    <div class="composer-actions">
                        <button type="button" class="upload-floating-btn" id="upload-btn"
                                aria-label="{{ pageData.hero.uploadLabel }}"
                                title="{{ pageData.hero.uploadLabel }}">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 13v8"/><path d="m8 17 4-4 4 4"/><path d="M20.88 18.09A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.29"/></svg>
                            <span class="btn-label-full">{{ pageData.hero.uploadLabel }}</span>
                            <span class="btn-label-short">{{ pageData.hero.uploadLabelShort }}</span>
                        </button>
                        <button type="submit" class="submit-btn" id="start-btn">
                            <span class="btn-label-full">{{ pageData.hero.startLabel }}</span>
                            <span class="btn-label-short">{{ pageData.hero.startLabelShort }}</span>
                        </button>
                    </div>
                    <p class="error-box" id="paste-error-box" role="alert" hidden></p>
                </form>
            </div>
        </div>
    </section>

    {%- set features = pageData.features %}
    <section class="section" id="features">
        <div class="section-inner">
            <div class="section-head">
                <p class="eyebrow">{{ features.eyebrow }}</p>
                <h2 class="section-title">{{ features.title }}</h2>
                <p class="section-desc">{{ features.description }}</p>
            </div>
            <ul class="bento-grid">
                {%- for item in features.items %}
                <li class="bento-card {% if loop.index == 1 %}bento-span-2 bento-card--voice{% elif loop.index == 4 %}bento-span-2 bento-card--recording{% elif loop.index == 5 %}bento-span-2 bento-card--mobile{% elif loop.index == 6 %}bento-span-2{% elif loop.index == 7 %}bento-span-2 bento-card--ads{% endif %}">
                    <div class="bento-card-inner">
                        <div class="card-icon-box">
                            {% if loop.index == 1 %}
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="bento-icon"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v1a7 7 0 0 1-14 0v-1"/><line x1="12" x2="12" y1="19" y2="22"/></svg>
                            {% elif loop.index == 2 %}
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="bento-icon"><rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/><path d="M9 2h6"/></svg>
                            {% elif loop.index == 3 %}
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="bento-icon"><rect width="10" height="18" x="7" y="3" rx="2"/><path d="M11 7h2"/><path d="M11 11h2"/><path d="M12 15h.01"/></svg>
                            {% elif loop.index == 4 %}
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="bento-icon"><path d="M23 7a2 2 0 0 0-2.45-1.45L16 7V5a2 2 0 0 0-2-2H2a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2l4.55 1.45A2 2 0 0 0 23 17V7z"/></svg>
                            {% elif loop.index == 5 %}
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="bento-icon"><path d="m22 8-6 4 6 4V8Z"/><rect width="14" height="12" x="2" y="6" rx="2" ry="2"/><path d="M6 12h4"/></svg>
                            {% elif loop.index == 6 %}
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="bento-icon"><rect width="16" height="12" x="2" y="4" rx="2"/><path d="M12 18H7.5a1.5 1.5 0 0 1 0-3H18a1 1 0 0 1 1 1v2"/><path d="M8 20h8"/></svg>
                            {% elif loop.index == 7 %}
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="bento-icon"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                            {% endif %}
                        </div>
                        <div class="bento-card-text">
                            <h3 class="card-title">{{ item.title }}</h3>
                            <p class="card-desc">{{ item.description }}</p>
                        </div>
                        
                        {# Custom visual decoration for large cards #}
                        {% if loop.index == 1 %}
                        <div class="bento-visual voice-waves">
                            <span class="wave-line"></span>
                            <span class="wave-line"></span>
                            <span class="wave-line"></span>
                            <span class="wave-line"></span>
                            <span class="wave-line"></span>
                        </div>
                        {% elif loop.index == 4 %}
                        <div class="bento-visual recording-badge">
                            <span class="rec-dot"></span>
                            <span class="rec-time">00:02:45</span>
                        </div>
                        {% elif loop.index == 5 %}
                        <div class="bento-visual phone-outline">
                            <div class="notch-indicator"></div>
                        </div>
                        {% elif loop.index == 7 %}
                        <div class="bento-visual ads-visual">
                            <div class="no-ads-shield">
                                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                            </div>
                        </div>
                        {% endif %}
                    </div>
                </li>
                {%- endfor %}
            </ul>
        </div>
    </section>
 
    {%- set howItWorks = pageData.howItWorks %}
    <section class="section section-alt" id="how-it-works">
        <div class="section-inner">
            <div class="section-head">
                <p class="eyebrow">{{ howItWorks.eyebrow }}</p>
                <h2 class="section-title">{{ howItWorks.title }}</h2>
                <p class="section-desc">{{ howItWorks.description }}</p>
            </div>
            <ol class="steps-flow">
                {%- for step in howItWorks.steps %}
                <li class="step-card" id="{{ step.anchor }}">
                    <span class="step-giant-number">0{{ loop.index }}</span>
                    <div class="step-card-content">
                        <h3 class="card-title">{{ step.title }}</h3>
                        <p class="card-desc">{{ step.description }}</p>
                    </div>
                </li>
                {%- endfor %}
            </ol>
        </div>
    </section>
 
    {%- set voiceScroll = pageData.voiceScroll %}
    <section class="section" id="voice-scroll">
        <div class="section-inner split-section">
            <div class="split-text-col">
                <p class="eyebrow">{{ voiceScroll.eyebrow }}</p>
                <h2 class="section-title">{{ voiceScroll.title }}</h2>
                <p class="section-desc">{{ voiceScroll.description }}</p>
                <ul class="custom-benefits-list">
                    {%- for item in voiceScroll.benefits %}
                    <li>
                        <span class="benefit-bullet">✓</span>
                        <div class="benefit-info">
                            <strong class="benefit-title">{{ item.title }}</strong>
                            <p class="benefit-desc">{{ item.description }}</p>
                        </div>
                    </li>
                    {%- endfor %}
                </ul>
                <p class="section-support">{{ voiceScroll.supporting }}</p>
            </div>
            <div class="split-visual-col">
                <div class="browser-frame app-screenshot-wrapper">
                    <div class="browser-chrome">
                        <span class="chrome-dot red"></span>
                        <span class="chrome-dot yellow"></span>
                        <span class="chrome-dot green"></span>
                    </div>
                    <div class="browser-viewport">
                        <img src="/media/teleprompter-screenshot.jpg" alt="SolPrompter Studio Screen" class="app-screenshot">
                    </div>
                </div>
            </div>
        </div>
    </section>
 
    {%- set notch = pageData.notch %}
    <section class="section section-alt" id="notch">
        <div class="section-inner split-section split-reverse">
            <div class="split-text-col">
                <p class="eyebrow">{{ notch.eyebrow }}</p>
                <h2 class="section-title">{{ notch.title }}</h2>
                <p class="section-desc">{{ notch.description }}</p>
                <ul class="modern-checklist">
                    {%- for point in notch.items %}
                    <li>
                        <span class="check-bullet">✓</span>
                        <span class="check-text">{{ point }}</span>
                    </li>
                    {%- endfor %}
                </ul>
                <p class="section-support">{{ notch.supporting }}</p>
            </div>
            <div class="split-visual-col">
                <div class="browser-frame app-screenshot-wrapper">
                    <div class="browser-chrome">
                        <span class="chrome-dot red"></span>
                        <span class="chrome-dot yellow"></span>
                        <span class="chrome-dot green"></span>
                    </div>
                    <div class="browser-viewport">
                        <img src="/media/notch-screenshot.jpg" alt="SolPrompter Notch Mode Screen" class="app-screenshot">
                    </div>
                </div>
            </div>
        </div>
    </section>
 
    {%- set remote = pageData.remote %}
    <section class="section" id="remote">
        <div class="section-inner split-section">
            <div class="split-text-col">
                <p class="eyebrow">{{ remote.eyebrow }}</p>
                <h2 class="section-title">{{ remote.title }}</h2>
                <p class="section-desc">{{ remote.description }}</p>
                <ul class="custom-benefits-list">
                    {%- for item in remote.items %}
                    <li>
                        <span class="benefit-bullet">✓</span>
                        <div class="benefit-info">
                            <strong class="benefit-title">{{ item.title }}</strong>
                            <p class="benefit-desc">{{ item.description }}</p>
                        </div>
                    </li>
                    {%- endfor %}
                </ul>
                <p class="section-support">{{ remote.supporting }}</p>
            </div>
            <div class="split-visual-col">
                <div class="app-screenshot-wrapper mobile-screenshot-wrapper">
                    <img src="/media/teleprompter-mobile-screenshot.jpg" alt="VTeleprompter Mobile Studio Screen" class="app-screenshot">
                </div>
            </div>
        </div>
    </section>
 
    {%- set recording = pageData.recording %}
    <section class="section section-alt" id="recording">
        <div class="section-inner">
            <div class="section-head">
                <p class="eyebrow">{{ recording.eyebrow }}</p>
                <h2 class="section-title">{{ recording.title }}</h2>
                <p class="section-desc">{{ recording.description }}</p>
            </div>
            <ul class="cards-interactive-grid">
                {%- for item in recording.items %}
                <li class="interactive-card">
                    <span class="card-counter">0{{ loop.index }}</span>
                    <h3 class="card-title">{{ item.title }}</h3>
                    <p class="card-desc">{{ item.description }}</p>
                </li>
                {%- endfor %}
            </ul>
        </div>
    </section>
 
    {%- set workspace = pageData.workspace %}
    <section class="section" id="workspace">
        <div class="section-inner split-section">
            <div class="split-text-col">
                <p class="eyebrow">{{ workspace.eyebrow }}</p>
                <h2 class="section-title">{{ workspace.title }}</h2>
                <p class="section-desc">{{ workspace.description }}</p>
                <ul class="custom-benefits-list">
                    {%- for item in workspace.items %}
                    <li>
                        <span class="benefit-bullet">✓</span>
                        <div class="benefit-info">
                            <strong class="benefit-title">{{ item.title }}</strong>
                            <p class="benefit-desc">{{ item.description }}</p>
                        </div>
                    </li>
                    {%- endfor %}
                </ul>
            </div>
            <div class="split-visual-col">
                <div class="browser-frame app-screenshot-wrapper">
                    <div class="browser-chrome">
                        <span class="chrome-dot red"></span>
                        <span class="chrome-dot yellow"></span>
                        <span class="chrome-dot green"></span>
                    </div>
                    <div class="browser-viewport">
                        <img src="/media/workspaces-screenshot.jpg" alt="SolPrompter Workspace Library" class="app-screenshot">
                    </div>
                </div>
            </div>
        </div>
    </section>
 
    {%- set mobile = pageData.mobile %}
    <section class="section section-alt" id="mobile">
        <div class="section-inner split-section">
            <div class="split-text-col">
                <p class="eyebrow">{{ mobile.eyebrow }}</p>
                <h2 class="section-title">{{ mobile.title }}</h2>
                <p class="section-desc">{{ mobile.description }}</p>
                <ul class="cards-interactive-grid">
                    {%- for item in mobile.items %}
                    <li class="interactive-card">
                        <h3 class="card-title">{{ item.title }}</h3>
                        <p class="card-desc">{{ item.description }}</p>
                    </li>
                    {%- endfor %}
                </ul>
                <p class="section-support">{{ mobile.supporting }}</p>
            </div>
            <div class="split-visual-col device-showcase-visual">
                <div class="ipad-landscape-frame">
                    <img src="/media/ipad-landscape.jpg" alt="iPad Landscape View" class="device-img" />
                    <div class="mobile-qr-remote">
                        <img src="/media/mobile-remote.jpg" alt="Mobile Remote Control" class="device-img-overlay" />
                    </div>
                </div>
            </div>
        </div>
    </section>
 
    {%- set useCases = pageData.useCases %}
    <section class="section" id="use-cases">
        <div class="section-inner">
            <div class="section-head">
                <p class="eyebrow">{{ useCases.eyebrow }}</p>
                <h2 class="section-title">{{ useCases.title }}</h2>
            </div>
            <ul class="cards-interactive-grid">
                {%- for item in useCases.items %}
                <li class="interactive-card">
                    <h3 class="card-title">{{ item.title }}</h3>
                    <p class="card-desc">{{ item.description }}</p>
                </li>
                {%- endfor %}
            </ul>
        </div>
    </section>
 
    {%- set comparison = pageData.comparison %}
    <section class="section section-alt" id="why">
        <div class="section-inner">
            <div class="section-head">
                <p class="eyebrow">{{ comparison.eyebrow }}</p>
                <h2 class="section-title">{{ comparison.title }}</h2>
                <p class="section-desc">{{ comparison.description }}</p>
            </div>
            <div class="comparison-table-wrapper" style="overflow-x: auto; margin-top: 2rem;">
                <table class="comparison-table">
                    <thead>
                        <tr>
                            {%- for header in comparison.table.headers %}
                            <th>{{ header }}</th>
                            {%- endfor %}
                        </tr>
                    </thead>
                    <tbody>
                        {%- for row in comparison.table.rows %}
                        <tr>
                            <td><strong>{{ row.feature }}</strong></td>
                            <td><strong>{{ row.sol }}</strong></td>
                            <td>{{ row.smart }}</td>
                            <td>{{ row.mirror }}</td>
                        </tr>
                        {%- endfor %}
                    </tbody>
                </table>
            </div>

            {%- if comparison.whyChoose %}
            <div class="why-choose-details" style="margin-top: 4rem;">
                <h3 class="section-subtitle" style="text-align: center; margin-bottom: 2rem; font-size: 1.75rem; color: var(--text-heading);">{{ comparison.whyChoose.title }}</h3>
                <div class="why-choose-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; margin-top: 2rem;">
                    {%- for item in comparison.whyChoose.items %}
                    <div class="why-choose-card" style="padding: 2rem; background: var(--bg-surface); border-radius: 8px; border: 1px solid var(--border); box-shadow: var(--shadow-sm);">
                        <h4 style="font-size: 1.25rem; margin-bottom: 1rem; color: var(--text-heading);">{{ item.title }}</h4>
                        <p style="font-size: 0.95rem; line-height: 1.6; color: var(--text-muted);">{{ item.description }}</p>
                    </div>
                    {%- endfor %}
                </div>
            </div>
            {%- endif %}

            <p class="section-support" style="margin-top: 3rem; text-align: center;">{{ comparison.supporting }}</p>
        </div>
    </section>
 
    {%- set about = pageData.about %}
    <section class="section" id="about">
        <div class="section-inner section-narrow">
            <div class="section-head">
                <p class="eyebrow">{{ about.eyebrow }}</p>
                <h2 class="section-title">{{ about.title }}</h2>
            </div>
            <div class="prose-content">
                {%- for paragraph in about.paragraphs %}
                <p class="prose-paragraph">{{ paragraph }}</p>
                {%- endfor %}
            </div>
        </div>
    </section>
 
    {%- set faq = pageData.faq %}
    <section class="section section-alt" id="faq">
        <div class="section-inner section-narrow">
            <div class="section-head">
                <p class="eyebrow">{{ faq.eyebrow }}</p>
                <h2 class="section-title">{{ faq.title }}</h2>
            </div>
            <div class="faq-container">
                {%- for item in faq.items %}
                <details class="faq-accordion-item" id="{{ item.anchor }}">
                    <summary class="faq-summary">
                        <span class="faq-question-text">{{ item.q }}</span>
                        <svg class="faq-chevron-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                    </summary>
                    <div class="faq-content">
                        <p class="faq-answer-text">{{ item.a | safe }}</p>
                    </div>
                </details>
                {%- endfor %}
            </div>
        </div>
    </section>

    {%- set finalCta = pageData.finalCta %}
    <section class="section final-cta" id="start">
        <div class="section-inner section-narrow">
            <p class="eyebrow">{{ finalCta.eyebrow }}</p>
            <h2 class="section-title">{{ finalCta.title }}</h2>
            <p class="section-desc">{{ finalCta.description }}</p>
            <div class="section-cta"><a class="btn btn-primary btn-lg" href="{{ finalCta.cta.url }}">{{ finalCta.cta.label }}</a></div>
            <p class="section-support">{{ finalCta.supporting }}</p>
        </div>
    </section>
</main>

<!-- FOOTER -->
<footer class="footer">
    <div class="footer-inner">
        <div class="footer-top">
            <div class="footer-brand">
                <a href="/" class="brand" aria-label="SolPrompter home">{{ logoSvg | safe }}<span class="footer-logo-text">{{ pageData.footer.brand }}</span></a>
                <p class="footer-desc">{{ pageData.footer.description }}</p>
            </div>
            <div class="footer-cols">
                {%- for column in pageData.footer.columns %}
                <div class="footer-col">
                    <h3 class="footer-col-title">{{ column.title }}</h3>
                    <ul class="footer-col-links">
                        {%- for link in column.links %}
                        <li><a href="{{ link.url }}" class="footer-link">{{ link.label }}</a></li>
                        {%- endfor %}
                    </ul>
                </div>
                {%- endfor %}
            </div>
        </div>
        <div class="footer-bottom">
            <p class="footer-copyright">{{ pageData.footer.copyright }}</p>
        </div>
    </div>
</footer>

