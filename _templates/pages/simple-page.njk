---
layout: simple-page-base.njk
pagination:
  data: simplePages
  size: 1
  alias: simplePage
permalink: /{{ simplePage.slug }}.html
lang: en
---
<!-- Generated from _templates/_data/simple-pages/*.json. Do not edit this file directly. -->
{%- set pageData = i18nPages['blog'][lang] or i18nPages['blog']['en'] -%}
{%- set canonical = site.url + '/' + simplePage.slug -%}
{%- set simplePageUrl = '/' + simplePage.slug -%}
{%- set home = site.url + '/' -%}
{%- set socialImage = site.url + (simplePage.seo.ogImage or '') -%}
{%- from "partials/logo.njk" import brandLogo -%}
{%- from "partials/social-links.njk" import socialLinks -%}
{%- set logoSvg = brandLogo('currentColor') -%}

<a class="skip-link" href="#page-content">Skip to content</a>

<header class="nav simple-page-nav">
    <div class="nav-inner">
        <div class="nav-left">
            <a href="/" class="brand" aria-label="SolPrompter home">{{ logoSvg | safe }}<span class="brand-text">SolPrompter</span></a>
            <nav class="nav-menu" aria-label="Primary">
                {%- for item in pageData.nav.items %}
                {%- set isCurrent = item.url == simplePageUrl -%}
                <a href="{{ item.url }}" class="nav-item{% if isCurrent %} nav-item-current{% endif %}"{% if isCurrent %} aria-current="page"{% endif %}>{{ item.label }}</a>
                {%- endfor %}
            </nav>
        </div>
        <div class="nav-right">
            <a href="{{ pageData.nav.cta.url }}" class="btn btn-workspaces">{{ pageData.nav.cta.label }}</a>
        </div>
    </div>
</header>

<main id="page-content" class="simple-page-main" tabindex="-1">
    {%- if simplePage.article %}
    <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@graph": [
                {
                    "@type": "Article",
                    "@id": "{{ canonical }}#article",
                    "mainEntityOfPage": { "@id": "{{ canonical }}#webpage" },
                    "headline": "{{ simplePage.title | jsonString | safe }}",
                    "description": "{{ simplePage.seo.description | jsonString | safe }}",
                    "image": { "@id": "{{ canonical }}#primaryimage" },
                    "dateModified": "{{ simplePage.article.dateModified }}",
                    "author": {
                        "@type": "Organization",
                        "name": "{{ simplePage.article.author.name | jsonString | safe }}",
                        "url": "{{ site.url }}{{ simplePage.article.author.url }}"
                    },
                    "publisher": {
                        "@type": "Organization",
                        "name": "{{ site.name }}",
                        "url": "{{ home }}"
                    },
                    "isPartOf": { "@id": "{{ home }}#website" },
                    "inLanguage": "en"
                },
                {
                    "@type": "WebPage",
                    "@id": "{{ canonical }}#webpage",
                    "url": "{{ canonical }}",
                    "name": "{{ simplePage.seo.title | jsonString | safe }}",
                    "description": "{{ simplePage.seo.description | jsonString | safe }}",
                    "isPartOf": {
                        "@type": "WebSite",
                        "@id": "{{ home }}#website",
                        "name": "{{ site.name }}",
                        "url": "{{ home }}"
                    },
                    "primaryImageOfPage": { "@id": "{{ canonical }}#primaryimage" },
                    "breadcrumb": { "@id": "{{ canonical }}#breadcrumb" },
                    "dateModified": "{{ simplePage.article.dateModified }}",
                    "inLanguage": "en"
                },
                {
                    "@type": "ImageObject",
                    "@id": "{{ canonical }}#primaryimage",
                    "url": "{{ socialImage }}",
                    "contentUrl": "{{ socialImage }}",
                    "width": {{ simplePage.seo.ogImageWidth }},
                    "height": {{ simplePage.seo.ogImageHeight }},
                    "caption": "{{ simplePage.seo.ogImageAlt | jsonString | safe }}"
                },
                {
                    "@type": "BreadcrumbList",
                    "@id": "{{ canonical }}#breadcrumb",
                    "itemListElement": [
                        {
                            "@type": "ListItem",
                            "position": 1,
                            "name": "{{ simplePage.breadcrumb.homeLabel | jsonString | safe }}",
                            "item": "{{ home }}"
                        },
                        {
                            "@type": "ListItem",
                            "position": 2,
                            "name": "{{ simplePage.breadcrumb.currentLabel | jsonString | safe }}",
                            "item": "{{ canonical }}"
                        }
                    ]
                }
            ]
        }
    </script>
    {%- else %}
    <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "WebPage",
            "@id": "{{ canonical }}#webpage",
            "name": "{{ simplePage.title | jsonString | safe }}",
            "description": "{{ simplePage.seo.description | jsonString | safe }}",
            "url": "{{ canonical }}",
            "isPartOf": {
                "@type": "WebSite",
                "name": "{{ site.name }}",
                "url": "{{ site.url }}"
            },
            "inLanguage": "en-US"
        }
    </script>
    {%- endif %}

    <article class="simple-page-content">
        <header class="simple-page-header">
            {%- if simplePage.breadcrumb %}
            <nav class="simple-page-breadcrumb" aria-label="{{ simplePage.breadcrumb.label }}">
                <ol>
                    <li><a href="/">{{ simplePage.breadcrumb.homeLabel }}</a></li>
                    <li aria-current="page">{{ simplePage.breadcrumb.currentLabel }}</li>
                </ol>
            </nav>
            {%- endif %}
            <h1>{{ simplePage.title }}</h1>
            {%- if simplePage.article %}
            <div class="simple-page-article-meta">
                <span>{{ simplePage.article.byLabel }} <a rel="author" href="{{ simplePage.article.author.url }}">{{ simplePage.article.author.name }}</a></span>
                <span>{{ simplePage.article.updatedLabel }} <time datetime="{{ simplePage.article.dateModified }}">{{ simplePage.article.dateModifiedDisplay }}</time></span>
            </div>
            {%- endif %}
        </header>

        <div class="simple-page-prose">
            {%- if simplePage.toc %}
            <nav class="simple-page-toc" aria-labelledby="simple-page-toc-title">
                <h2 id="simple-page-toc-title">{{ simplePage.toc.title }}</h2>
                <ol>
                    {%- for block in simplePage.content %}
                    {%- if block.type == 'heading' and block.id %}
                    <li><a href="#{{ block.id }}">{{ block.text }}</a></li>
                    {%- endif %}
                    {%- endfor %}
                </ol>
            </nav>
            {%- endif %}
            {%- if simplePage.toc %}
            {%- for block in simplePage.content %}
                {%- if block.type == 'paragraph' %}
                <p>{{ block.html | safe }}</p>
                {%- elif block.type == 'heading' %}
                <h2{% if block.id %} id="{{ block.id }}"{% endif %}>{{ block.text }}</h2>
                {%- elif block.type == 'list' %}
                <ul>
                    {%- for item in block.items %}
                    <li>{{ item }}</li>
                    {%- endfor %}
                </ul>
                {%- elif block.type == 'image' %}
                <figure class="simple-page-figure">
                    <img src="{{ block.src }}" alt="{{ block.alt }}" width="{{ block.width }}" height="{{ block.height }}" loading="lazy" decoding="async">
                    {%- if block.caption %}
                    <figcaption>{{ block.caption }}</figcaption>
                    {%- endif %}
                </figure>
                {%- endif %}
            {%- endfor %}
            {%- else %}
            {%- for block in simplePage.content %}
                {% if block.type == 'paragraph' %}
                <p>{{ block.html | safe }}</p>
                {% elif block.type == 'heading' %}
                <h2{% if block.id %} id="{{ block.id }}"{% endif %}>{{ block.text }}</h2>
                {% elif block.type == 'list' %}
                <ul>
                    {%- for item in block.items %}
                    <li>{{ item }}</li>
                    {%- endfor %}
                </ul>
                {% elif block.type == 'image' %}
                <figure class="simple-page-figure">
                    <img src="{{ block.src }}" alt="{{ block.alt }}" width="{{ block.width }}" height="{{ block.height }}" loading="lazy" decoding="async">
                    {%- if block.caption %}
                    <figcaption>{{ block.caption }}</figcaption>
                    {%- endif %}
                </figure>
                {% endif %}
            {%- endfor %}
            {%- endif %}
        </div>
    </article>
</main>

<footer class="footer simple-page-footer">
    <div class="footer-inner">
        <div class="footer-logo">
            <a href="/" class="brand" aria-label="SolPrompter home">{{ logoSvg | safe }}<span class="footer-logo-text">SolPrompter</span></a>
        </div>
        <div class="footer-links">
            {%- for link in pageData.footer.links %}
            {%- set isCurrent = link.url == simplePageUrl -%}
            <a href="{{ link.url }}" class="footer-link{% if isCurrent %} footer-link-current{% endif %}"{% if isCurrent %} aria-current="page"{% endif %}>{{ link.label }}</a>
            {%- endfor %}
        </div>
        {{ socialLinks(site.social) }}
        <div class="footer-copyright">{{ pageData.footer.copyright }}</div>
    </div>
</footer>
